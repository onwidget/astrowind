---
/**
 * Visible placeholder for personal media (photos, video) to be added later.
 * Renders the production brief on top of a styled frame, so the slot is
 * obvious in reviews and the final asset has clear art direction.
 */
interface Props {
  brief: string;
  label?: string;
  class?: string;
}
const { brief, label = 'Photo placeholder', class: className = 'aspect-[4/5]' } = Astro.props;
---

<figure
  class:list={[
    'relative flex items-center justify-center overflow-hidden rounded-2xl border border-dashed border-edge bg-moss bg-dotgrid',
    className,
  ]}
>
  <figcaption class="max-w-xs p-6 text-center">
    <svg class="mx-auto mb-4 h-8 w-8 text-haze" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.4"></rect>
      <circle cx="9" cy="10" r="1.6" stroke="currentColor" stroke-width="1.4"></circle>
      <path d="M5 17l4.5-4 3.5 3 2.5-2L19 17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
    </svg>
    <p class="label-mono text-spore">{label}</p>
    <p class="mt-3 text-xs leading-relaxed text-haze">{brief}</p>
  </figcaption>
</figure>
