---
import Wordmark from './Wordmark.astro';
import { coreTeam } from '~/data/team';
import { site, locationLine } from '~/data/site';
import { footerNav, legalNav } from '~/navigation';

const year = new Date().getFullYear();
---

<footer class="border-t border-edge bg-deep">
  <div class="container-site grid gap-12 py-16 md:grid-cols-[2fr_1fr_1fr_1fr]">
    <div>
      <a href="/" aria-label={`${site.name} — home`}><Wordmark /></a>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-haze">
        A boutique nearshore software consultancy based in Latin America. Senior, certified, English-fluent
        professionals who assemble into the exact team your problem needs.
      </p>
      <p class="label-mono mt-6">{locationLine} · Your time zone</p>
    </div>

    <nav aria-label="Footer — explore">
      <p class="label-mono mb-4 text-mist">Explore</p>
      <ul class="space-y-2.5 text-sm">
        {
          footerNav.map(({ text, href }) => (
            <li>
              <a href={href} class="text-haze transition-colors hover:text-spore">
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Footer — team">
      <p class="label-mono mb-4 text-mist">Team</p>
      <ul class="space-y-2.5 text-sm">
        {
          coreTeam.map((m) => (
            <li>
              <a href={`/${m.slug}`} class="text-haze transition-colors hover:text-spore">
                {m.name.split(' ')[0]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="label-mono mb-4 text-mist">Talk to us</p>
      <ul class="space-y-2.5 text-sm">
        <li>
          <a href={`mailto:${site.email}`} class="text-haze transition-colors hover:text-spore">{site.email}</a>
        </li>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener" class="text-haze transition-colors hover:text-spore">
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-edge">
    <div
      class="container-site flex flex-col gap-2 py-6 text-xs text-haze md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} {site.name}. {site.tagline}</p>
      <p class="flex gap-5">
        {
          legalNav.map(({ text, href }) => (
            <a href={href} class="transition-colors hover:text-spore">
              {text}
            </a>
          ))
        }
      </p>
    </div>
  </div>
</footer>
