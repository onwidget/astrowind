---
interface Props {
  class?: string;
}
const { class: className = 'h-7' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <!-- Node-network mark: independent points connecting into structure -->
  <svg viewBox="0 0 32 32" fill="none" class="h-full w-auto" aria-hidden="true">
    <path d="M7 24 L16 7 M16 7 L26 14 M26 14 L13 17 M13 17 L7 24 M13 17 L22 26" stroke="#8fa89b" stroke-width="1.1" opacity="0.7"></path>
    <circle cx="7" cy="24" r="2.4" fill="#b8f53d"></circle>
    <circle cx="16" cy="7" r="3" fill="#b8f53d"></circle>
    <circle cx="26" cy="14" r="2.2" fill="#eaf3ec"></circle>
    <circle cx="13" cy="17" r="1.8" fill="#eaf3ec"></circle>
    <circle cx="22" cy="26" r="1.6" fill="#8fa89b"></circle>
  </svg>
  <span class="font-display text-xl font-semibold tracking-tight text-mist">codemyc</span>
</span>
