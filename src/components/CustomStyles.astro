---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Codemyc Brand Colors — Light Mode */
    --aw-color-primary: rgb(6 182 212);       /* Teal / Cyan */
    --aw-color-secondary: rgb(8 145 178);     /* Deeper Cyan */
    --aw-color-accent: rgb(99 102 241);       /* Indigo accent */

    --aw-color-text-heading: rgb(10 15 44);   /* Deep navy */
    --aw-color-text-default: rgb(30 35 60);
    --aw-color-text-muted: rgb(30 35 60 / 64%);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-page-dark: rgb(6 10 36);

    ::selection {
      background-color: rgb(6 182 212 / 20%);
      color: rgb(10 15 44);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Codemyc Brand Colors — Dark Mode */
    --aw-color-primary: rgb(34 211 238);      /* Bright Cyan */
    --aw-color-secondary: rgb(6 182 212);     /* Teal */
    --aw-color-accent: rgb(129 140 248);      /* Soft Indigo */

    --aw-color-text-heading: rgb(240 245 255);
    --aw-color-text-default: rgb(210 220 240);
    --aw-color-text-muted: rgb(210 220 240 / 60%);
    --aw-color-bg-page: rgb(6 10 36);

    ::selection {
      background-color: rgb(34 211 238 / 20%);
      color: rgb(240 245 255);
    }
  }

  /* Gradient hero background */
  .codemyc-hero-bg {
    background: linear-gradient(135deg, rgb(6 10 36) 0%, rgb(10 20 60) 50%, rgb(6 25 50) 100%);
  }

  /* Glowing accent line */
  .codemyc-accent-line {
    background: linear-gradient(90deg, transparent, rgb(6 182 212), transparent);
  }

  /* Team card hover effect */
  .team-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .team-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(6, 182, 212, 0.15);
  }

  /* Service card hover */
  .service-card {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .service-card:hover {
    border-color: rgb(6 182 212 / 60%);
    box-shadow: 0 8px 32px rgba(6, 182, 212, 0.12);
  }
</style>
