---
/**
 * Font system (2026 UX/UI recommendation)
 *
 *   Display (h1, h2)      → Geist Variable       — Vercel's 2025 engineering
 *                                                  display sans; signals
 *                                                  "modern engineering-first
 *                                                  practice" to $1M+ B2B
 *                                                  buyers.
 *   Body   (paragraphs,   → Inter Variable        — 2026 B2B SaaS default,
 *           UI, nav, CTA)    (already loaded)        optimized for screen
 *                                                  reading at 14–18px.
 *   Mono   (technical     → JetBrains Mono         — Geist's natural mono
 *           labels,                                  pair. Use for tag IDs
 *           "01 / 04", etc.)                          ("01 / 04"), code,
 *                                                  kbd-like elements.
 *
 * All three are open-source variable fonts shipped via @fontsource-variable,
 * so we get 1) zero external requests (better LCP, better privacy, GDPR-clean),
 * 2) the full weight axis without per-weight round-trips, and 3) full offline
 * support — all of which improve Core Web Vitals, a direct SEO KPI.
 *
 * The font stack is exposed via the existing --aw-font-* CSS variables so the
 * rest of the codebase continues to reference --font-sans / --font-serif /
 * --font-heading without rewiring utilities.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
---

<style is:inline>
  :root {
    /* Display sans — used by .text-hero / .text-section (heading roles). */
    --aw-font-heading: 'Geist Variable', 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    /* Body sans — used for paragraph copy, nav, CTAs, eyebrows. */
    --aw-font-sans: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    /* Mono — used for technical labels and code. */
    --aw-font-serif: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-heading: 'Geist Variable', 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-sans: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace;

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>