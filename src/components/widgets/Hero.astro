---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  /** Optional four-quadrant entry cards rendered right under the trust list. */
  quadrants = await Astro.slots.render('quadrants'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative md:-mt-[76px] not-prose hero-nix" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none hero-nix__bg" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20">
      <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
        {
          tagline && (
            <p
              class="hero-nix__eyebrow accent-rule text-sm text-secondary dark:text-blue-200 font-bold tracking-wide uppercase inline-block intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="hero-nix__title text-hero font-heading dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade mb-6"
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class="hero-nix__subtitle text-xl text-muted mb-6 dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}

        {
          quadrants && (
            <div class="hero-nix__quadrants mt-12 md:mt-16">
              {Array.isArray(quadrants) ? (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5 text-left max-w-5xl mx-auto">
                  {quadrants.map((q) => (
                    <a
                      href={q.href}
                      class="hero-nix__card group intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                      data-quadrant={q.key}
                    >
                      <div class="hero-nix__card-inner">
                        <div class="hero-nix__card-icon">
                          <Icon name={q.icon} class="w-6 h-6" />
                        </div>
                        <div class="hero-nix__card-body">
                          <div class="hero-nix__card-meta">
                            <span class="hero-nix__card-step">{q.step}</span>
                            <span class="hero-nix__card-divider" aria-hidden="true">/</span>
                            <span class="hero-nix__card-label">{q.label}</span>
                          </div>
                          <h3 class="hero-nix__card-title" set:html={q.title} />
                          <p class="hero-nix__card-desc">{q.description}</p>
                        </div>
                        <span class="hero-nix__card-arrow" aria-hidden="true">
                          <Icon name="tabler:arrow-up-right" class="w-5 h-5" />
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              ) : (
                <Fragment set:html={quadrants} />
              )}
            </div>
          )
        }
      </div>
      {
        image && (
          <div
            class="intersect-once intersect-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          >
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto rounded-md w-full"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  width={1024}
                  height={576}
                  format="webp"
                  {...image}
                />
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* -------- Hero entrance choreography --------
   * Sequential reveal reads as: eyebrow → title → subtitle → CTAs → cards.
   * Each step is delayed via --hf-delay so the order feels intentional
   * rather than racing in unison. Cards stagger further so they fan in. */
  .hero-nix .hero-nix__eyebrow,
  .hero-nix .hero-nix__title,
  .hero-nix .hero-nix__subtitle,
  .hero-nix .hero-nix__quadrants > .grid > .hero-nix__card {
    animation-delay: var(--hf-delay, 0ms);
  }
  .hero-nix .hero-nix__eyebrow { --hf-delay: 60ms; }
  .hero-nix .hero-nix__title { --hf-delay: 180ms; }
  .hero-nix .hero-nix__subtitle { --hf-delay: 320ms; }
  .hero-nix .hero-nix__quadrants > .grid > .hero-nix__card:nth-child(1) { --hf-delay: 460ms; }
  .hero-nix .hero-nix__quadrants > .grid > .hero-nix__card:nth-child(2) { --hf-delay: 560ms; }
  .hero-nix .hero-nix__quadrants > .grid > .hero-nix__card:nth-child(3) { --hf-delay: 660ms; }
  .hero-nix .hero-nix__quadrants > .grid > .hero-nix__card:nth-child(4) { --hf-delay: 760ms; }

  /* Reduce motion: snap everything in. */
  @media (prefers-reduced-motion: reduce) {
    .hero-nix .hero-nix__eyebrow,
    .hero-nix .hero-nix__title,
    .hero-nix .hero-nix__subtitle,
    .hero-nix .hero-nix__quadrants > .grid > .hero-nix__card {
      animation: none !important;
      animation-delay: 0ms !important;
    }
  }

  /* -------- Hero card skin (n-ix-style four-quadrant hero) -------- */
  .hero-nix {
    --hero-nix-bg-from: #0b1437;
    --hero-nix-bg-via: #112156;
    --hero-nix-bg-to: #06112e;
    --hero-nix-card-bg: rgba(255, 255, 255, 0.06);
    --hero-nix-card-bg-hover: rgba(255, 255, 255, 0.1);
    --hero-nix-card-border: rgba(255, 255, 255, 0.14);
    --hero-nix-card-border-hover: rgba(120, 168, 255, 0.55);
    --hero-nix-accent: #6ea8ff;
    --hero-nix-text: #f5f7fb;
    --hero-nix-text-muted: rgba(245, 247, 251, 0.72);
  }

  /* Override the hero text colors over the dark background */
  .hero-nix .hero-nix__eyebrow {
    color: #a9c2ff !important;
  }
  .hero-nix .hero-nix__title {
    color: #ffffff;
  }
  .hero-nix .hero-nix__subtitle {
    color: rgba(245, 247, 251, 0.78) !important;
  }

  /* Dark background with a subtle radial pattern + grid lines (n-ix home feel) */
  .hero-nix__bg {
    background:
      radial-gradient(1000px 520px at 12% 18%, rgba(110, 168, 255, 0.18), transparent 60%),
      radial-gradient(900px 480px at 88% 88%, rgba(109, 40, 217, 0.18), transparent 60%),
      linear-gradient(180deg, var(--hero-nix-bg-from) 0%, var(--hero-nix-bg-via) 55%, var(--hero-nix-bg-to) 100%);
  }
  .hero-nix__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.65), transparent 78%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.65), transparent 78%);
    pointer-events: none;
  }
  .hero-nix__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(closest-side at 20% 30%, rgba(110, 168, 255, 0.18), transparent 70%),
      radial-gradient(closest-side at 80% 70%, rgba(109, 40, 217, 0.18), transparent 70%);
    pointer-events: none;
  }

  /* ---------- Quadrant cards ---------- */
  .hero-nix__quadrants {
    width: 100%;
  }
  .hero-nix__card {
    display: block;
    color: var(--hero-nix-text);
    text-decoration: none;
    border-radius: 14px;
    background: var(--hero-nix-card-bg);
    border: 1px solid var(--hero-nix-card-border);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: transform 220ms ease, background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
    position: relative;
    overflow: hidden;
  }
  .hero-nix__card:hover,
  .hero-nix__card:focus-visible {
    background: var(--hero-nix-card-bg-hover);
    border-color: var(--hero-nix-card-border-hover);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -18px rgba(110, 168, 255, 0.6);
    outline: none;
  }
  .hero-nix__card:hover .hero-nix__card-arrow,
  .hero-nix__card:focus-visible .hero-nix__card-arrow {
    transform: translate(2px, -2px);
    color: var(--hero-nix-accent);
  }
  .hero-nix__card:hover .hero-nix__card-icon,
  .hero-nix__card:focus-visible .hero-nix__card-icon {
    background: rgba(110, 168, 255, 0.18);
    color: var(--hero-nix-accent);
  }
  .hero-nix__card-inner {
    display: grid;
    grid-template-columns: 44px 1fr 24px;
    align-items: start;
    gap: 14px;
    padding: 18px 18px 18px 18px;
  }
  .hero-nix__card-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
    color: #cfe0ff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 220ms ease, color 220ms ease;
  }
  .hero-nix__card-body {
    min-width: 0;
  }
  .hero-nix__card-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--aw-font-sans, 'Inter Variable', system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .hero-nix__card-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 22px;
    padding: 0 6px;
    border-radius: 6px;
    background: rgba(110, 168, 255, 0.22);
    color: #cfe0ff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    font-family: var(--aw-font-serif, ui-monospace, SFMono-Regular, monospace);
  }
  .hero-nix__card-divider {
    display: none;
  }
  .hero-nix__card-label {
    color: #ffffff;
    font-weight: 600;
  }
  .hero-nix__card-title {
    color: #ffffff;
    font-size: 1.0625rem;
    line-height: 1.25;
    font-weight: 700;
    margin: 0 0 4px 0;
    letter-spacing: -0.01em;
  }
  .hero-nix__card-desc {
    color: var(--hero-nix-text-muted);
    font-size: 0.875rem;
    line-height: 1.45;
    margin: 0;
  }
  .hero-nix__card-arrow {
    color: var(--hero-nix-text-muted);
    transition: transform 220ms ease, color 220ms ease;
    flex-shrink: 0;
    margin-top: 4px;
  }

  @media (max-width: 480px) {
    .hero-nix__card-inner {
      grid-template-columns: 40px 1fr 22px;
      gap: 12px;
      padding: 16px 16px 16px 16px;
    }
    .hero-nix__card-icon {
      width: 40px;
      height: 40px;
    }
    .hero-nix__card-title {
      font-size: 1rem;
    }
  }

  /* Light mode fallback — keep the dark hero on light mode too so it doesn't
     visibly clash with the rest of the page; only soften the nav region. */
</style>

<script>
  // Toggle the header's .scrolled class once the dark hero is no longer
  // fully behind the sticky nav. This lets the CSS :has() rule above
  // switch the header back to its default light theme.
  (() => {
    const header = document.querySelector('header');
    const hero = document.querySelector('.hero-nix');
    if (!header || !hero) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const heroBottom = hero.getBoundingClientRect().bottom;
      const headerH = header.getBoundingClientRect().height || 76;
      const scrolled = heroBottom < headerH + 8;
      header.classList.toggle('scrolled', scrolled);
    };
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  })();
</script>
