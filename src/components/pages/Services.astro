---
/*
 * Services page: the international-workforce intro, then the two audiences the
 * document separates — families, and corporate clients.
 *
 * Band rhythm as on the home page: isDark ⇔ tone="navy", tones alternating.
 */
import Layout from '~/layouts/PageLayout.astro';

import BandBg from '~/components/brand/BandBg.astro';
import SeamMedallion from '~/components/brand/SeamMedallion.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import familyCare from '~/assets/images/family-care.webp';
import hospitality from '~/assets/images/hospitality.webp';
import manufacturing from '~/assets/images/manufacturing.webp';

import { useContent } from '~/i18n/content';
import type { Lang } from '~/i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const c = useContent(lang);
const t = c.services;
---

<Layout metadata={t.meta} lang={lang}>
  <!-- Uluslararası İş Gücü — NAVY (first band, no seam above) ********** -->

  <div class="dark">
    <Hero tagline={t.hero.tagline}>
      <Fragment slot="bg">
        <BandBg tone="navy" seam={false} />
      </Fragment>

      <Fragment slot="title">
        <span class="text-heading">{t.hero.title}</span>
      </Fragment>

      <Fragment slot="subtitle">
        {t.hero.paragraphs.map((text) => <p class="mb-4 last:mb-0">{text}</p>)}
      </Fragment>

      <Fragment slot="content">
        <hr class="brand-rule mx-auto mt-14 w-40 opacity-70" />
      </Fragment>
    </Hero>
  </div>

  <SeamMedallion tone="navy" />

  <!-- Ev ve Bakım Personeli — IVORY **************************************** -->

  <Content
    id={t.family.id}
    title={t.family.title}
    items={t.family.items}
    image={{ src: familyCare, alt: t.family.imageAlt }}
  >
    <Fragment slot="content">
      {t.family.paragraphs.map((text) => <p class="mb-4 last:mb-0">{text}</p>)}
    </Fragment>

    <Fragment slot="bg">
      <BandBg tone="ivory" />
    </Fragment>
  </Content>

  <!-- Kurumsal İş Gücü Çözümleri — NAVY ******************************** -->

  <Content
    isDark
    isReversed
    id={t.corporate.id}
    title={t.corporate.title}
    image={{ src: hospitality, alt: t.corporate.hospitalityAlt }}
  >
    <Fragment slot="content">
      {t.corporate.paragraphs.map((text) => <p class="mb-4 last:mb-0">{text}</p>)}
    </Fragment>

    <Fragment slot="bg">
      <BandBg tone="navy" />
    </Fragment>
  </Content>

  <!-- The three corporate offers — IVORY ****************************** -->

  <Features3 columns={3} items={t.corporate.items} image={{ src: manufacturing, alt: t.corporate.manufacturingAlt }}>
    <Fragment slot="bg">
      <BandBg tone="ivory" />
    </Fragment>
  </Features3>

  <!-- Contact — NAVY ************************************************** -->

  <CallToAction isDark title={c.contact.hero.title} subtitle={c.contact.hero.subtitle} actions={[c.contact.cta]}>
    <Fragment slot="bg">
      <BandBg tone="navy" />
    </Fragment>
  </CallToAction>
</Layout>
