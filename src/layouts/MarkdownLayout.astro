---
import SiteLayout from '~/layouts/SiteLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<SiteLayout metadata={metadata}>
  <section class="container-site max-w-4xl pt-36 pb-20">
    <h1 class="heading-display text-4xl md:text-5xl">{frontmatter.title}</h1>
    <div class="prose prose-invert prose-headings:font-display prose-a:text-spore mt-10 max-w-none text-haze">
      <slot />
    </div>
  </section>
</SiteLayout>
