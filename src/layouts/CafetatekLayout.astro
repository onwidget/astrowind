---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import FloatingCTA from '~/components/widgets/FloatingCTA.astro';

import { buildNavigation } from '~/utils/navigation-i18n';
import type { Locale } from '~/utils/translations';
import type { MetaData } from '~/types';

export interface Props {
  locale: Locale;
  metadata?: MetaData;
}

const { locale, metadata } = Astro.props;
const nav = buildNavigation(locale);
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header {...nav.header} isSticky />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...nav.footer} />
  </slot>
  <FloatingCTA locale={locale} />
</Layout>

<script>
  // Preline UI: load the dropdown plugin (powers the "What we do" mega-menu).
  // The bundle registers its own `window.load` autoInit handler, but Astro's
  // view-transition swaps don't fire `load` again — so we re-init on
  // `astro:after-swap` to keep the menu wired up after client-side navigation.
  import('preline/plugins/dropdown');
  document.addEventListener('astro:after-swap', () => {
    const Preline = (window as unknown as { HSDropdown?: { autoInit?: () => void } }).HSDropdown;
    Preline?.autoInit?.();
  });
</script>

<style is:global>
  /* Cafetatek aesthetic refresh — applied globally to all pages using this layout.
     All rules preserve the existing color palette (primary / secondary / muted / accent).
     Kept as utility classes so widget composition stays declarative.

     Color-mix is used (not hsl(alpha)) so the underlying CSS variable can be a hex
     color and the alpha is applied at composition time. */

  /* ----- Typography (UX-tuned 2026 scale)
   * Target audience: senior B2B buyers at $1M+ ARR companies who skim a
   * landing page in 5-7 seconds. The hero must invite, not dominate;
   * section headings must feel authoritative without filling the screen.
   *
   * Mobile-first scale; tablet at 768px; desktop at 1024px; ultrawide at 1280px.
   * Numbers derived from a 1.25 modular scale with -2.5% optical letter-spacing
   * on display sizes to keep type crisp at large weights.
   *
   * Font roles (see CustomStyles.astro for the variable definitions):
   *   .text-hero / .text-section / h1 / h2 → Geist Variable (display sans)
   *   body / paragraphs / nav / CTAs       → Inter Variable
   *   .text-mono / kbd / technical labels   → JetBrains Mono Variable
   */

  /* Hero h1: 44/56/64/72 across mobile → ultrawide.
   * Was 48/68/88/96 — too dominant on desktop. Now uses the Geist display
   * family for the "modern engineering" commercial signal. */
  .text-hero {
    font-family: var(--aw-font-heading);
    font-size: 2.75rem;
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 700;
    font-variation-settings: 'wght' 700;
    font-feature-settings: 'ss01' on, 'cv11' on;
  }
  @media (min-width: 768px) {
    .text-hero { font-size: 3.5rem; }
  }
  @media (min-width: 1024px) {
    .text-hero { font-size: 4rem; }
  }
  @media (min-width: 1280px) {
    .text-hero { font-size: 4.5rem; letter-spacing: -0.04em; }
  }

  /* Section h2: 32/40/44/48.
   * Was 36/48/56 — too screen-filling on desktop. Geist at 700 weight. */
  .text-section {
    font-family: var(--aw-font-heading);
    font-size: 2rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 700;
    font-variation-settings: 'wght' 700;
    font-feature-settings: 'ss01' on, 'cv11' on;
  }
  @media (min-width: 768px) {
    .text-section { font-size: 2.5rem; }
  }
  @media (min-width: 1024px) {
    .text-section { font-size: 2.75rem; letter-spacing: -0.03em; }
  }

  /* Body & supporting copy: keep the html root at 16px (WCAG baseline, respects
   * browser zoom). Typography scales are applied via rem in the .text-* utilities. */
  html {
    font-size: 16px;
  }

  /* Eyebrow labels: keep tight, slightly bigger on desktop for scanability. */
  .text-eyebrow {
    font-family: var(--aw-font-sans);
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    font-weight: 700;
  }
  @media (min-width: 1024px) {
    .text-eyebrow { font-size: 0.875rem; }
  }

  /* Mono utility: technical labels (01 / 04, tag IDs, code-like strings). */
  .text-mono {
    font-family: var(--aw-font-serif);
    font-feature-settings: 'liga' 0, 'calt' 0; /* disable ligatures for mono alignment */
    font-variant-numeric: tabular-nums;
  }

  /* Globally apply the Geist display family to all heading elements that
   * fall back to the browser default (when widgets render <h1>/<h2>/<h3>
   * without a Tailwind font class). Body / nav / CTAs keep Inter. */
  h1,
  h2,
  h3,
  .font-heading {
    font-family: var(--aw-font-heading);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-feature-settings: 'ss01' on, 'cv11' on;
  }

  /* Body copy & nav: Inter Variable, with a 1.55 line-height for screen
   * readability at 15–17px. */
  body {
    font-family: var(--aw-font-sans);
    font-feature-settings: 'cv11' on, 'ss01' on;
    line-height: 1.55;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ----- Hero wash ----- */

  /* Hero section: apply soft primary wash */
  section#home {
    background-image:
      radial-gradient(ellipse 80% 50% at 50% 0%, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent), transparent 60%),
      linear-gradient(to bottom, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 4%, transparent), transparent 60%);
  }
  .dark section#home {
    background-image:
      radial-gradient(ellipse 80% 50% at 50% 0%, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 18%, transparent), transparent 60%),
      linear-gradient(to bottom, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 8%, transparent), transparent 60%);
  }

  /* ----- Accent rule (small primary dash before eyebrow text) ----- */
  .accent-rule::before {
    content: '';
    display: inline-block;
    width: 2.25rem;
    height: 2px;
    background: var(--aw-color-primary, #1e88e5);
    vertical-align: middle;
    margin-right: 0.6rem;
    transform: translateY(-2px);
  }

  /* ----- Stat ribbon ----- */

  .stat-ribbon {
    background-image: linear-gradient(
      120deg,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent) 0%,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 4%, transparent) 50%,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent) 100%
    );
    border-top: 1px solid color-mix(in srgb, var(--aw-color-primary, #1e88e5) 20%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--aw-color-primary, #1e88e5) 20%, transparent);
  }

  /* ----- Card hover ----- */

  .card-hover {
    transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }
  .card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--aw-color-primary, #1e88e5) 25%, transparent);
  }

  /* ----- Problem card left accent ----- */

  .problem-card {
    position: relative;
    overflow: hidden;
    border-left: 3px solid var(--aw-color-primary, #1e88e5);
  }

  /* ----- Pillar icon chip ----- */

  .pillar-icon {
    background: color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent);
    color: var(--aw-color-primary, #1e88e5);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--aw-color-primary, #1e88e5) 20%, transparent);
    transition: background 280ms ease, color 280ms ease, box-shadow 280ms ease;
  }
  .pillar-card:hover .pillar-icon {
    background: var(--aw-color-primary, #1e88e5);
    color: white;
    box-shadow: inset 0 0 0 1px var(--aw-color-primary, #1e88e5);
  }

  /* ----- Package card top accent stripe ----- */

  .pkg-card {
    position: relative;
    overflow: hidden;
  }
  .pkg-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(to right,
      transparent 0%,
      var(--aw-color-primary, #1e88e5) 50%,
      transparent 100%);
    opacity: 0;
    transition: opacity 280ms ease;
  }
  .pkg-card:hover::before { opacity: 1; }

  /* ----- Section divider ----- */

  .section-divider {
    border-top: 1px solid color-mix(in srgb, var(--color-border, #e2e8f0) 40%, transparent);
  }

  /* ----- Vertical rhythm -----
   * Sections feel less sprawling on desktop without losing breathing room.
   * py-12 sm:py-14 lg:py-16 is the new default vs the previous py-24 peak. */
  .section-rhythm {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }
  @media (min-width: 768px) {
    .section-rhythm {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }
  @media (min-width: 1024px) {
    .section-rhythm {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  /* ----- Methodology tag ----- */

  .methodology-tag {
    background-image: linear-gradient(120deg,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent),
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 4%, transparent));
    color: var(--aw-color-primary, #1e88e5);
  }

  /* ----- Header on dark hero -----
   * The Cafetatek hero is a dark gradient. To keep the header readable on
   * top of the hero (and on every other page below the hero), the header
   * is always rendered with a light frosted surface and dark text.
   * The light frosted look is the unified theme across all sections — the
   * sticky bar visually separates the nav from the brand surface below it.
   *
   * Pixel-perfect layout: the header sits at the top with a soft white
   * background and a subtle bottom border. The :has() selector scopes
   * these rules to pages that render the dark hero (so other pages keep
   * their default theme). */
  body:has(> header + main .hero-nix) header {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }
  body:has(> header + main .hero-nix) header,
  body:has(> header + main .hero-nix) header a,
  body:has(> header + main .hero-nix) header button,
  body:has(> header + main .hero-nix) header nav,
  body:has(> header + main .hero-nix) header nav a,
  body:has(> header + main .hero-nix) header nav button {
    color: rgb(16, 16, 16);
  }
  body:has(> header + main .hero-nix) header a:hover,
  body:has(> header + main .hero-nix) header button:hover {
    color: rgb(1 97 239);
  }
  body:has(> header + main .hero-nix) header span {
    color: rgb(16, 16, 16) !important;
  }
  /* Dropdown menu on light header */
  body:has(> header + main .hero-nix) header .dropdown-menu {
    background-color: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  body:has(> header + main .hero-nix) header .dropdown-menu li a {
    color: rgb(16, 16, 16) !important;
  }
  body:has(> header + main .hero-nix) header .dropdown-menu li a:hover {
    background-color: rgba(15, 23, 42, 0.04);
    color: rgb(1 97 239) !important;
  }

  /* ----- Header compact mode on tablet -----
   * At 768–1023px the full nav (Home / What we do / Why choose us / Our work /
   * Pages / Blog / Contact) doesn't fit. Hide the secondary links (Pages,
   * Blog) on tablet so the primary 4 sections + Contact stay visible.
   * Restore them on lg+ where there is room. */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    body:has(> header + main .hero-nix) header nav ul > li:nth-last-child(3),
    body:has(> header + main .hero-nix) header nav ul > li:nth-last-child(2) {
      display: none;
    }
    /* On tablet, shrink the Cafetatek wordmark so the first nav link
       doesn't squeeze against it. */
    body:has(> header + main .hero-nix) header > div > div > a > span {
      font-size: 1.125rem;
    }
  }

  /* ----- Hero button theming -----
   * The hero is dark; the `btn-secondary` (outlined) and `btn-primary` (filled)
   * inherit dark text by default. On the dark hero we need:
   *   - btn-primary: white text on accent fill (already correct, leave alone)
   *   - btn-secondary: white text on a translucent surface, white border */
  body:has(> header + main .hero-nix) .hero-nix .btn-secondary {
    color: rgba(255, 255, 255, 0.95);
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.06);
  }
  body:has(> header + main .hero-nix) .hero-nix .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.6);
    color: #ffffff;
  }
  body:has(> header + main .hero-nix) .hero-nix .btn-primary {
    color: #ffffff;
  }
</style>