---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';

import { buildNavigation } from '~/utils/navigation-i18n';
import type { Locale } from '~/utils/translations';
import type { MetaData } from '~/types';

export interface Props {
  locale: Locale;
  metadata?: MetaData;
}

const { locale, metadata } = Astro.props;
const nav = buildNavigation(locale);
---

<Layout metadata={metadata}>
  <slot name="announcement">
    <Announcement />
  </slot>
  <slot name="header">
    <Header {...nav.header} isSticky showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...nav.footer} />
  </slot>
</Layout>

<style is:global>
  /* Cafetatek aesthetic refresh — applied globally to all pages using this layout.
     All rules preserve the existing color palette (primary / secondary / muted / accent).
     Kept as utility classes so widget composition stays declarative.

     Color-mix is used (not hsl(alpha)) so the underlying CSS variable can be a hex
     color and the alpha is applied at composition time. */

  /* ----- Typography ----- */

  /* Hero: larger, tighter typography */
  .text-hero {
    font-size: 3rem;
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 800;
  }
  @media (min-width: 768px) {
    .text-hero { font-size: 4.25rem; }
  }
  @media (min-width: 1024px) {
    .text-hero { font-size: 5.5rem; }
  }
  @media (min-width: 1280px) {
    .text-hero { font-size: 6rem; }
  }

  /* Section headings: one notch bigger, still tight */
  .text-section {
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  @media (min-width: 768px) {
    .text-section { font-size: 3rem; }
  }
  @media (min-width: 1024px) {
    .text-section { font-size: 3.5rem; }
  }

  /* ----- Hero wash ----- */

  /* Hero section: apply soft primary wash */
  section#home {
    background-image:
      radial-gradient(ellipse 80% 50% at 50% 0%, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent), transparent 60%),
      linear-gradient(to bottom, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 4%, transparent), transparent 60%);
  }
  .dark section#home {
    background-image:
      radial-gradient(ellipse 80% 50% at 50% 0%, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 18%, transparent), transparent 60%),
      linear-gradient(to bottom, color-mix(in srgb, var(--aw-color-primary, #1e88e5) 8%, transparent), transparent 60%);
  }

  /* ----- Accent rule (small primary dash before eyebrow text) ----- */
  .accent-rule::before {
    content: '';
    display: inline-block;
    width: 2.25rem;
    height: 2px;
    background: var(--aw-color-primary, #1e88e5);
    vertical-align: middle;
    margin-right: 0.6rem;
    transform: translateY(-2px);
  }

  /* ----- Stat ribbon ----- */

  .stat-ribbon {
    background-image: linear-gradient(
      120deg,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent) 0%,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 4%, transparent) 50%,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent) 100%
    );
    border-top: 1px solid color-mix(in srgb, var(--aw-color-primary, #1e88e5) 20%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--aw-color-primary, #1e88e5) 20%, transparent);
  }

  /* ----- Card hover ----- */

  .card-hover {
    transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }
  .card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--aw-color-primary, #1e88e5) 25%, transparent);
  }

  /* ----- Problem card left accent ----- */

  .problem-card {
    position: relative;
    overflow: hidden;
    border-left: 3px solid var(--aw-color-primary, #1e88e5);
  }

  /* ----- Pillar icon chip ----- */

  .pillar-icon {
    background: color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent);
    color: var(--aw-color-primary, #1e88e5);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--aw-color-primary, #1e88e5) 20%, transparent);
    transition: background 280ms ease, color 280ms ease, box-shadow 280ms ease;
  }
  .pillar-card:hover .pillar-icon {
    background: var(--aw-color-primary, #1e88e5);
    color: white;
    box-shadow: inset 0 0 0 1px var(--aw-color-primary, #1e88e5);
  }

  /* ----- Package card top accent stripe ----- */

  .pkg-card {
    position: relative;
    overflow: hidden;
  }
  .pkg-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(to right,
      transparent 0%,
      var(--aw-color-primary, #1e88e5) 50%,
      transparent 100%);
    opacity: 0;
    transition: opacity 280ms ease;
  }
  .pkg-card:hover::before { opacity: 1; }

  /* ----- Section divider ----- */

  .section-divider {
    border-top: 1px solid color-mix(in srgb, var(--color-border, #e2e8f0) 40%, transparent);
  }

  /* ----- Methodology tag ----- */

  .methodology-tag {
    background-image: linear-gradient(120deg,
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 10%, transparent),
      color-mix(in srgb, var(--aw-color-primary, #1e88e5) 4%, transparent));
    color: var(--aw-color-primary, #1e88e5);
  }
</style>