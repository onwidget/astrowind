---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';

const metadata = {
  title: 'Codemyc — Elite Technology Professionals',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- ====== HERO ====== -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Meet Our Team',
        href: '/team',
        icon: 'tabler:users',
      },
      { text: 'Explore Services', href: '/services' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 codemyc-hero-bg"></div>
    </Fragment>
    <Fragment slot="title">
      <span class="text-white">Elite technology professionals,</span>
      <br />
      <span class="text-cyan-400">real business results.</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-slate-300">
        Codemyc is a boutique technology studio built around exceptional individuals. We bring senior-level expertise in
        institutional web portals, mobile applications, software architecture, and data analytics tailored precisely to
        your business challenges.
      </span>
    </Fragment>
    <Fragment slot="content">
      <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto text-center border-t border-white/10 pt-8">
        <div>
          <div class="text-3xl font-bold text-cyan-400">10+</div>
          <div class="text-sm text-slate-400 mt-1">Projects delivered</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-cyan-400">5+</div>
          <div class="text-sm text-slate-400 mt-1">Years of experience</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-cyan-400">100%</div>
          <div class="text-sm text-slate-400 mt-1">Certified staff</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-cyan-400">100%</div>
          <div class="text-sm text-slate-400 mt-1">Client satisfaction</div>
        </div>
      </div>
    </Fragment>
  </Hero>

  <!-- VALUE STRIP -->
  <div class="py-6 bg-cyan-500/10 dark:bg-cyan-500/5 border-y border-cyan-500/20">
    <p class="text-center text-sm md:text-base font-semibold text-cyan-700 dark:text-cyan-300 tracking-wide uppercase">
      Government &amp; Institutional Portals &nbsp;&middot;&nbsp; Mobile Applications &nbsp;&middot;&nbsp; Software Architecture &nbsp;&middot;&nbsp; Data Analytics &nbsp;&middot;&nbsp; System Integration
    </p>
  </div>

  <!-- SERVICES OVERVIEW -->
  <Features2
    id="services"
    title="What we do exceptionally well"
    subtitle="Five core competencies backed by certified professionals with years of real-world delivery experience."
    tagline="Our Expertise"
    columns={3}
    items={[
      {
        title: 'Institutional and Government Portals',
        description: 'We design and build highly secure, accessible, and compliant web portals for government agencies, universities, hospitals, and public institutions. Rigorous standards met, every time.',
        icon: 'tabler:building-community',
      },
      {
        title: 'Mobile Application Development',
        description: 'Cross-platform and native mobile apps that drive real engagement. From MVP to full-scale product, our mobile team handles iOS, Android, and hybrid solutions.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Software Architecture and Engineering',
        description: 'Scalable, maintainable systems designed for growth. We architect microservices, APIs, cloud infrastructure, and DevOps pipelines that your business can rely on.',
        icon: 'tabler:sitemap',
      },
      {
        title: 'Data Analytics and Intelligence',
        description: 'Unlock the value hidden in your data. We build dashboards, pipelines, and predictive models that give your leadership team the insights to make faster, smarter decisions.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Bespoke Web Applications',
        description: 'Custom-crafted web platforms engineered to streamline operations, automate workflows, and create exceptional digital experiences that distinguish your brand.',
        icon: 'tabler:browser',
      },
      {
        title: 'Seamless System Integration',
        description: 'We connect your disparate tools, APIs, and platforms into a unified ecosystem eliminating data silos and enabling real-time information flow across your organization.',
        icon: 'tabler:plug-connected',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </Features2>

  <!-- TEAM TEASER -->
  <section class="py-16 md:py-20 px-4 sm:px-6 max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <p class="text-sm font-bold tracking-widest uppercase text-cyan-600 dark:text-cyan-400 mb-3">The People Behind the Work</p>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Senior professionals, <span class="text-cyan-500">not just developers</span>
      </h2>
      <p class="text-lg text-muted max-w-2xl mx-auto">
        Every project is led by an expert who owns the outcome end-to-end. Dedicated leads, clear communication, zero hand-off chaos.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      <div class="team-card rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-8 flex flex-col items-center text-center">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-cyan-400 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold mb-5 shadow-lg">OP</div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Orlando Pantoja</h3>
        <p class="text-cyan-600 dark:text-cyan-400 text-sm font-semibold mt-1 mb-3">Technology Lead</p>
        <p class="text-muted text-sm leading-relaxed">Drives technical strategy, architecture decisions, and delivery excellence across all Codemyc engagements. Specialized in scalable systems and cloud-native platforms.</p>
        <div class="flex gap-2 mt-4 flex-wrap justify-center">
          <span class="px-2 py-1 bg-cyan-100 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 text-xs rounded-full">Architecture</span>
          <span class="px-2 py-1 bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 text-xs rounded-full">Cloud</span>
          <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs rounded-full">DevOps</span>
        </div>
      </div>
      <div class="team-card rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-8 flex flex-col items-center text-center">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-teal-400 to-cyan-600 flex items-center justify-center text-white text-2xl font-bold mb-5 shadow-lg">ML</div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Mobile Lead</h3>
        <p class="text-cyan-600 dark:text-cyan-400 text-sm font-semibold mt-1 mb-3">Mobile Engineering Lead</p>
        <p class="text-muted text-sm leading-relaxed">Expert in cross-platform mobile development, delivering polished iOS and Android applications from concept through to App Store and Play Store deployment.</p>
        <div class="flex gap-2 mt-4 flex-wrap justify-center">
          <span class="px-2 py-1 bg-teal-100 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 text-xs rounded-full">React Native</span>
          <span class="px-2 py-1 bg-cyan-100 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 text-xs rounded-full">Flutter</span>
          <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs rounded-full">iOS / Android</span>
        </div>
      </div>
      <div class="team-card rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-8 flex flex-col items-center text-center">
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-indigo-400 to-purple-600 flex items-center justify-center text-white text-2xl font-bold mb-5 shadow-lg">DA</div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white">Data Lead</h3>
        <p class="text-cyan-600 dark:text-cyan-400 text-sm font-semibold mt-1 mb-3">Data Analytics Lead</p>
        <p class="text-muted text-sm leading-relaxed">Transforms raw data into strategic business intelligence. Builds end-to-end pipelines, dashboards, and predictive models that enable data-driven decisions.</p>
        <div class="flex gap-2 mt-4 flex-wrap justify-center">
          <span class="px-2 py-1 bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 text-xs rounded-full">Python</span>
          <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300 text-xs rounded-full">SQL</span>
          <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs rounded-full">Power BI</span>
        </div>
      </div>
    </div>
    <div class="text-center">
      <a href="/team" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-cyan-500 text-cyan-600 dark:text-cyan-400 font-semibold hover:bg-cyan-500 hover:text-white dark:hover:bg-cyan-500 dark:hover:text-white transition-all duration-300">
        Meet the full team
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <Steps
    title="How a Codemyc engagement works"
    tagline="Our Process"
    subtitle="Transparent, structured, and outcome-focused from day one."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Discovery and Scoping</span>',
        description: 'We invest time upfront to deeply understand your business context, technical landscape, and success criteria. No generic proposals, everything is tailored to your specific challenge.',
        icon: 'tabler:search',
      },
      {
        title: 'Step 2: <span class="font-medium">Architecture and Planning</span>',
        description: 'Our technical leads design a solution blueprint. Tech stack, timelines, team assignments, and milestones all defined and agreed before a single line of code is written.',
        icon: 'tabler:map',
      },
      {
        title: 'Step 3: <span class="font-medium">Agile Delivery</span>',
        description: 'We build in structured sprints with regular demos, transparent progress updates, and continuous feedback loops. You always know exactly where things stand.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Step 4: <span class="font-medium">Launch and Ongoing Support</span>',
        description: 'We own the deployment process and provide post-launch support. Your success is our success, we stay engaged to ensure everything performs as designed.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Team collaboration',
    }}
  />

  <!-- WHY CODEMYC -->
  <Features
    id="why-codemyc"
    tagline="Why Codemyc"
    title="The boutique advantage"
    subtitle="When you work with Codemyc, you work directly with the senior professionals doing the work, not layers of account management."
    items={[
      {
        title: 'Senior-only professionals',
        description: 'No juniors learning on your dime. Every role in every project is filled by a certified, experienced specialist who has solved this problem before.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Deep domain expertise',
        description: 'From government compliance requirements to mobile performance optimization, our team brings the specific domain knowledge your project demands.',
        icon: 'tabler:brain',
      },
      {
        title: 'Direct expert access',
        description: 'You communicate directly with the engineers and architects building your product. Clear answers, fast decisions, no telephone games.',
        icon: 'tabler:messages',
      },
      {
        title: 'Ownership mentality',
        description: 'We take full ownership of outcomes, not just deliverables, and we stay accountable through launch and beyond.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Proven delivery track record',
        description: 'With 10+ projects delivered across industries including public sector, fintech, and healthcare, our track record speaks for itself.',
        icon: 'tabler:trophy',
      },
      {
        title: 'Transparent, honest engagement',
        description: 'We tell you what is realistic. If something is a bad idea, we say so. Our reputation depends on your success.',
        icon: 'tabler:eye-check',
      },
    ]}
  />

  <!-- TESTIMONIALS -->
  <Testimonials
    title="What our clients say"
    tagline="Client Stories"
    subtitle="Real feedback from the businesses and institutions we have partnered with."
    testimonials={[
      {
        testimonial: 'Codemyc did not just deliver a portal, they understood our institutional requirements inside and out. The level of technical depth and professionalism was outstanding. Compliance, security, accessibility, all handled flawlessly.',
        name: 'Director of Digital Transformation',
        job: 'Government Agency',
        image: { src: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?ixlib=rb-4.0.3&auto=format&fit=crop&w=930&q=80', alt: 'Client' },
      },
      {
        testimonial: 'The mobile app they built for us was launched on time, on budget, and with zero critical bugs on day one. Their team communicated proactively throughout, refreshing to work with engineers who actually keep you in the loop.',
        name: 'Chief Product Officer',
        job: 'Fintech Startup',
        image: { src: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=774&q=80', alt: 'Client' },
      },
      {
        testimonial: 'Our data was sitting in silos for years. Codemyc designed a pipeline and analytics layer that finally gave our leadership team real-time visibility. We made better decisions in the first month than we had in the previous year.',
        name: 'VP of Operations',
        job: 'Healthcare Organization',
        image: { src: 'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?ixlib=rb-4.0.3&auto=format&fit=crop&w=774&q=80', alt: 'Client' },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </Testimonials>

  <!-- CTA -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'Start a Conversation', href: '/contact', icon: 'tabler:send' },
      { text: 'View Our Services', href: '/services' },
    ]}
  >
    <Fragment slot="title">
      Ready to work with <span class="text-cyan-500">elite professionals</span>?
    </Fragment>
    <Fragment slot="subtitle">
      No sales pitch, no templates. Just a real conversation about how Codemyc can deliver meaningful results for your business.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 codemyc-hero-bg"></div>
    </Fragment>
  </CallToAction>
</Layout>
