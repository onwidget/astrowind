---
import CafetatekLayout from '~/layouts/CafetatekLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import MethodologyCarousel from '~/components/widgets/MethodologyCarousel.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { t, type Locale } from '~/utils/translations';

const locale: Locale = 'en';
const dict = t(locale);

const metadata = {
  title: dict.site.tagline,
  ignoreTitleTemplate: true,
};
---

<CafetatekLayout locale={locale} metadata={metadata}>
  <!-- 1. Hero -->
  <Hero
    id="home"
    actions={[
      { variant: 'primary', text: dict.hero.primaryCta, href: '/contact', icon: 'tabler:calendar-event' },
      { text: dict.hero.secondaryCta, href: '#pillars', icon: 'tabler:chart-bar' }
    ]}
    quadrants={dict.hero.quadrants}
  >
    <Fragment slot="title">{dict.hero.title}</Fragment>
    <Fragment slot="subtitle">{dict.hero.subtitle}</Fragment>
  </Hero>

  <!-- 1.5. Methodology carousel (right after hero, above stats) -->
  <MethodologyCarousel
    id="methodology"
    eyebrow="How we deliver"
    title="A repeatable, audit-friendly delivery model."
    subtitle="The same way the platform engineering movement was supposed to. Senior engineers, structured phases, your team owns every step of the result."
    steps={dict.methodology.steps}
    ctaText={dict.hero.primaryCta}
  />

  <!-- 2. Stat bar (N-iX style) -->
  <section id="stats" class="stat-ribbon py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-10 sm:mb-12">
        <p class="accent-rule text-secondary text-sm font-bold tracking-wide uppercase inline-block mb-3">{dict.homepage.stats.eyebrow}</p>
        <h2 class="text-section text-balance">
          {dict.homepage.stats.title}
        </h2>
      </div>
      <Stats
        id="stats-numbers"
        stats={dict.stats.items}
      />
    </div>
  </section>

  <!-- 3. Problem statement (N-iX style) — custom 2-col Tailwind grid -->
  <section id="problem" class="bg-background py-12 sm:py-16 lg:py-24 section-divider">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-10 sm:mb-14 lg:mb-16">
        <p class="accent-rule text-secondary text-sm font-bold tracking-wide uppercase inline-block mb-3">{dict.homepage.problem.eyebrow}</p>
        <h2 class="text-section text-balance">
          {dict.homepage.problem.title}
        </h2>
      </div>

      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        <article class="problem-card card-hover bg-muted/40 border border-border/40 rounded-xl p-6 sm:p-9">
          <p class="text-secondary text-sm font-bold tracking-wide uppercase mb-3">{dict.homepage.problem.cto.role}</p>
          <p class="text-foreground text-lg leading-relaxed">{dict.homepage.problem.cto.text}</p>
        </article>
        <article class="problem-card card-hover bg-muted/40 border border-border/40 rounded-xl p-6 sm:p-9">
          <p class="text-secondary text-sm font-bold tracking-wide uppercase mb-3">{dict.homepage.problem.ciso.role}</p>
          <p class="text-foreground text-lg leading-relaxed">{dict.homepage.problem.ciso.text}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Six service pillars (the brief's 6 core offerings) -->
  <Features
    id="pillars"
    tagline={dict.pillars.eyebrow}
    title={dict.pillars.title}
    subtitle={dict.pillars.subtitle}
    columns={3}
    items={dict.pillars.items.map((it) => ({
      title: it.title,
      description: `${it.description}\n\n${it.bullets.slice(0, 3).map((b) => `• ${b}`).join('\n')}`,
      icon: it.icon,
      callToAction: { text: 'Discuss this pillar', href: '/contact' }
    }))}
  />

  <!-- 5. Case studies (N-iX style — 3 cards) -->
  <section id="case-studies" class="bg-background py-12 sm:py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-10 sm:mb-14 lg:mb-16">
        <p class="accent-rule text-secondary text-sm font-bold tracking-wide uppercase inline-block mb-3">{dict.homepage.caseStudies.eyebrow}</p>
        <h2 class="text-section text-balance">
          {dict.homepage.caseStudies.title}
        </h2>
        <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-lg sm:text-xl">
          {dict.homepage.caseStudies.subtitle}
        </p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
        {dict.homepage.caseStudies.items.map((cs, i) => (
          <article class="card-hover bg-muted/40 border border-border/40 rounded-xl p-6 sm:p-8 flex flex-col gap-4">
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                {cs.client}
              </span>
              <span class="text-muted-foreground text-xs">{cs.period}</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-secondary text-xs font-bold tracking-wide uppercase">{cs.industry}</span>
              <span class="text-muted-foreground text-xs">{cs.service}</span>
            </div>
            <h3 class="text-lg font-bold leading-tight text-balance">{cs.title}</h3>
            <p class="text-muted-foreground text-sm leading-relaxed">{cs.outcome}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Pre-sales CTA (AstroWind style) -->
  <CallToAction
    id="contact"
    actions={[
      { variant: 'primary', text: dict.cta.primaryCta, href: '/contact', icon: 'tabler:calendar-event' },
      { text: dict.cta.secondaryCta, href: 'mailto:hello@cafetatek.com?subject=Brief', icon: 'tabler:mail' }
    ]}
  >
    <Fragment slot="title">{dict.cta.title}</Fragment>
    <Fragment slot="subtitle">
      {dict.cta.subtitle}
      <br class="hidden md:inline" />
      <span class="block mt-4 text-xs font-medium tracking-widest uppercase text-muted dark:text-slate-400">
        {dict.cta.note}
      </span>
    </Fragment>
  </CallToAction>
</CafetatekLayout>
