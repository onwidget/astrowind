---
import SiteLayout from '~/layouts/SiteLayout.astro';
import MyceliumCanvas from '~/components/site/MyceliumCanvas.astro';
import MemberGlyph from '~/components/site/MemberGlyph.astro';
import MemberPhoto from '~/components/site/MemberPhoto.astro';
import { coreTeam } from '~/data/team';

const metadata = {
  title: 'Codemyc — Senior Software, Direct',
  description:
    'A boutique nearshore software consultancy in Latin America. Senior, certified, English-fluent engineers who assemble into the exact team your problem needs — in your time zone, at nearshore rates.',
  ignoreTitleTemplate: true,
};

const services = [
  {
    title: 'Institutional & government platforms',
    desc: 'Public-sector portals built to survive auditors: WCAG accessibility, security, migrations, enterprise search.',
    href: '/services#institutional',
  },
  {
    title: 'Web applications',
    desc: 'Bespoke products and platforms — from architecture to launch — built by the seniors you met on day one.',
    href: '/services#web',
  },
  {
    title: 'Mobile applications',
    desc: 'Cross-platform apps with production architecture, real release pipelines, and crash-free track records.',
    href: '/services#mobile',
  },
  {
    title: 'AI integration',
    desc: 'RAG, agents, and MCP integrations that do real work on your data — not demos that die in staging.',
    href: '/services#ai',
  },
  {
    title: 'Cloud, DevOps & observability',
    desc: 'CI/CD, containerization, and telemetry your team can actually act on. Google Cloud certified.',
    href: '/services#cloud',
  },
  {
    title: 'System integration',
    desc: 'Legacy systems, third-party APIs, EDI, SOAP-to-REST — we make things that couldn’t talk to each other, talk.',
    href: '/services#integration',
  },
];

const steps = [
  {
    n: '01',
    title: 'You bring the problem',
    desc: 'A call with the engineers — not a sales layer. We scope it honestly, including what could go wrong.',
  },
  {
    n: '02',
    title: 'We assemble the team',
    desc: 'The exact mix of seniors your problem needs, hand-picked from the network. You never pay for roles you don’t need.',
  },
  {
    n: '03',
    title: 'We ship, you watch it happen',
    desc: 'Working in your time zone, in fluent English, with direct access to every person building. Then we support what we launched.',
  },
];
---

<SiteLayout metadata={metadata}>
  <!-- Hero -->
  <section class="relative flex min-h-screen items-center overflow-hidden">
    <MyceliumCanvas />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/30 via-transparent to-ink"></div>

    <div class="container-site relative z-10 pt-28 pb-20">
      <p class="label-mono" data-reveal>Nearshore software consultancy · Latin America · GMT−3</p>
      <h1
        class="heading-display mt-6 max-w-4xl text-5xl leading-[1.05] md:text-7xl"
        data-reveal
        data-reveal-delay="0.1"
      >
        Senior software, <span class="text-spore">direct.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-haze md:text-xl" data-reveal data-reveal-delay="0.2">
        A network of certified, battle-tested engineers who form the exact team your problem needs — web platforms,
        mobile apps, data systems. Your time zone. Fluent English. Rates that make sense.
      </p>
      <div class="mt-10 flex flex-wrap gap-4" data-reveal data-reveal-delay="0.3">
        <a href="/contact" class="btn-spore">Start a project</a>
        <a href="/team" class="btn-ghost">Meet the team</a>
      </div>

      <dl class="mt-20 grid max-w-3xl grid-cols-2 gap-x-8 gap-y-6 md:grid-cols-4" data-reveal-group>
        <div>
          <dt class="label-mono">English</dt>
          <dd class="font-display mt-1 text-2xl font-semibold text-mist">C2 fluent</dd>
        </div>
        <div>
          <dt class="label-mono">Certified by</dt>
          <dd class="font-display mt-1 text-2xl font-semibold text-mist">Google · Acquia</dd>
        </div>
        <div>
          <dt class="label-mono">Time zone gap</dt>
          <dd class="font-display mt-1 text-2xl font-semibold text-mist">Zero</dd>
        </div>
        <div>
          <dt class="label-mono">Seniority</dt>
          <dd class="font-display mt-1 text-2xl font-semibold text-mist">Only</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Statement -->
  <section class="border-t border-edge bg-deep">
    <div class="container-site py-24 md:py-32">
      <p class="label-mono" data-reveal>Why “Codemyc”</p>
      <p class="heading-display mt-6 max-w-4xl text-3xl leading-snug md:text-5xl" data-reveal>
        <span class="text-spore">Myc</span>, as in mycelium — the quiet network that makes the forest work. We plug into
        your business the same way: <span class="text-haze">low ego, high connectivity, lasting impact.</span>
      </p>
      <p class="mt-8 max-w-2xl text-haze" data-reveal>
        Not an agency with account managers between you and the people doing the work. Not offshore roulette. A small
        group of proven, actively practicing engineers — the ones a CTO friend would recommend.
      </p>
    </div>
  </section>

  <!-- Pillars -->
  <section class="border-t border-edge">
    <div class="container-site py-24 md:py-32">
      <p class="label-mono" data-reveal>What you get</p>
      <h2 class="heading-display mt-4 max-w-2xl text-3xl md:text-5xl" data-reveal>
        Six claims. Each one with proof behind it.
      </h2>

      <div
        class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-edge bg-edge md:grid-cols-2 lg:grid-cols-3"
        data-reveal-group
      >
        {
          [
            {
              t: 'Senior-only, by design',
              d: 'Every project is led and built by named, experienced engineers. No bait-and-switch staffing.',
            },
            {
              t: 'Battle-tested where it’s hardest',
              d: 'Government platforms delivered under real compliance, accessibility, and security requirements.',
            },
            {
              t: 'Certified, not just confident',
              d: 'Google and Acquia certifications, named per member on their profile pages.',
            },
            {
              t: 'You talk to the builders',
              d: 'Full English fluency, direct channels, no relay. Decisions happen in one conversation, not three.',
            },
            {
              t: 'Dynamic teams, per problem',
              d: 'Active, top-of-their-field professionals composed into the exact mix you need — and nothing you don’t.',
            },
            {
              t: 'Nearshore economics, zero friction',
              d: 'Latin America–based, working your hours, at rates a US or EU agency can’t touch. Savings from geography, never from seniority.',
            },
          ].map(({ t, d }) => (
            <div class="bg-moss p-8 transition-colors hover:bg-deep">
              <h3 class="font-display text-lg font-semibold text-mist">{t}</h3>
              <p class="mt-3 text-sm leading-relaxed text-haze">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-t border-edge bg-deep bg-dotgrid">
    <div class="container-site py-24 md:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="label-mono" data-reveal>Capabilities</p>
          <h2 class="heading-display mt-4 text-3xl md:text-5xl" data-reveal>What we build</h2>
        </div>
        <a href="/services" class="btn-ghost" data-reveal>All services</a>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {
          services.map(({ title, desc, href }) => (
            <a href={href} class="card-moss group p-8 transition-all hover:-translate-y-1 hover:border-spore/40">
              <h3 class="font-display text-lg font-semibold text-mist transition-colors group-hover:text-spore">
                {title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-haze">{desc}</p>
              <span class="label-mono mt-6 inline-block text-spore opacity-0 transition-opacity group-hover:opacity-100">
                Explore →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Dynamic team model -->
  <section class="border-t border-edge">
    <div class="container-site py-24 md:py-32">
      <p class="label-mono" data-reveal>How engagement works</p>
      <h2 class="heading-display mt-4 max-w-3xl text-3xl md:text-5xl" data-reveal>
        You don’t hire “Codemyc, twelve people.” You get the three seniors your problem actually needs.
      </h2>

      <div class="mt-16 grid gap-10 md:grid-cols-3" data-reveal-group>
        {
          steps.map(({ n, title, desc }) => (
            <div class="relative border-l border-edge pl-8">
              <span class="font-mono text-sm text-spore">{n}</span>
              <h3 class="font-display mt-3 text-xl font-semibold text-mist">{title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-haze">{desc}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-14 max-w-2xl text-haze" data-reveal>
        Because members are practicing professionals — not bench inventory — every engagement gets people who are sharp
        <em class="text-mist not-italic">right now</em>, and you never subsidize idle capacity. That’s a big part of why
        the price is competitive.
      </p>
    </div>
  </section>

  <!-- Team preview -->
  <section class="border-t border-edge bg-deep">
    <div class="container-site py-24 md:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="label-mono" data-reveal>The core</p>
          <h2 class="heading-display mt-4 text-3xl md:text-5xl" data-reveal>The people whose names you’ll know</h2>
        </div>
        <a href="/team" class="btn-ghost" data-reveal>The whole network</a>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-2" data-reveal-group>
        {
          coreTeam.map((m) => (
            <a
              href={`/${m.slug}`}
              class="card-moss group overflow-hidden transition-all hover:-translate-y-1 hover:border-spore/40"
            >
              {/* Portrait slot — swaps in automatically once `photo.image` is set in src/data/team.ts */}
              {m.photo.image ? (
                <MemberPhoto
                  image={m.photo.image}
                  alt={`Portrait of ${m.name}`}
                  focalPosition={m.photo.focalPosition}
                  class="aspect-[16/10] rounded-none border-0 border-b border-edge"
                />
              ) : (
                <MemberGlyph
                  name={m.name}
                  slug={m.slug}
                  class="aspect-[16/10] rounded-none border-0 border-b border-edge"
                />
              )}
              <div class="p-8">
                <p class="label-mono text-spore">{m.role}</p>
                <h3 class="font-display mt-2 text-2xl font-semibold text-mist">{m.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-haze">{m.owns}</p>
                <span class="label-mono mt-6 inline-block text-mist transition-colors group-hover:text-spore">
                  /{m.slug} →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="border-t border-edge">
    <div class="container-site py-20">
      <dl class="grid grid-cols-2 gap-10 md:grid-cols-4" data-reveal-group>
        <div>
          <dd class="font-display text-5xl font-semibold text-spore" data-count="9" data-count-suffix="+">9+</dd>
          <dt class="label-mono mt-2">Years shipping production software</dt>
        </div>
        <div>
          <dd class="font-display text-5xl font-semibold text-spore" data-count="67" data-count-suffix="+">67+</dd>
          <dt class="label-mono mt-2">Government portals maintained</dt>
        </div>
        <div>
          <dd class="font-display text-5xl font-semibold text-spore" data-count="8" data-count-suffix="+">8+</dd>
          <dt class="label-mono mt-2">Professional certifications</dt>
        </div>
        <div>
          <dd class="font-display text-5xl font-semibold text-spore" data-count="0">0</dd>
          <dt class="label-mono mt-2">Hours of time-zone gap with the Americas</dt>
        </div>
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden border-t border-edge bg-deep">
    <div class="container-site py-24 text-center md:py-32">
      <h2 class="heading-display mx-auto max-w-3xl text-4xl md:text-6xl" data-reveal>
        Tell us the problem. <span class="text-spore">We’ll bring the team.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-haze" data-reveal>
        First conversation is with the engineers. Scope, honest trade-offs, and a clear price — usually within days.
      </p>
      <div class="mt-10" data-reveal>
        <a href="/contact" class="btn-spore">Start a project</a>
      </div>
    </div>
  </section>
</SiteLayout>
