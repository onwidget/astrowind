---
import CafetatekLayout from '~/layouts/CafetatekLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Stats from '~/components/widgets/Stats.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { t, type Locale } from '~/utils/translations';

const locale: Locale = 'en';
const dict = t(locale);

const metadata = {
  title: dict.nav.about,
};
---

<CafetatekLayout locale={locale} metadata={metadata}>
  <Hero
    id="about-hero"
    tagline={dict.nav.about}
    actions={[
      { variant: 'primary', text: dict.cta.primaryCta, href: '/contact', icon: 'tabler:calendar-event' }
    ]}
  >
    <Fragment slot="title">A senior engineering practice for regulated industries, not a body shop.</Fragment>
    <Fragment slot="subtitle">Cafetatek is a senior-only engineering boutique for EMEA scale-ups in banking, fintech, healthcare, aviation, and global marketing. We are organised around six service pillars anchored on cloud + automation — cross-platform + migration consulting, cloud + platform engineering, AI-driven FinOps powered by Elixa, DevSecOps hardening, AI ChatOps + Agentic RPA migration, and AI Governance + MCP Gateway integration. Plus training programs and cybersecurity assessments that extend the same practice into team enablement and executive briefings.</Fragment>
  </Hero>

  <Note
    title="What the practice does"
    description="We deliver six service pillars: cross-platform + migration consulting, cloud + platform engineering, AI-driven FinOps (Elixa), DevSecOps hardening, AI ChatOps + Agentic RPA migration, and AI Governance + MCP Gateway integration. Plus training programs and cybersecurity assessments. All anchored on cloud + automation; all of them ship to production — no slideware, no advisory-only handoffs. Senior-only delivery, fixed scope, cloud-agnostic, and a 30-day warranty on every engagement."
  />

  <Stats
    id="stats"
    stats={dict.stats.items}
  />

  <FAQs
    id="faq"
    tagline={dict.faq.eyebrow}
    title={dict.faq.title}
    subtitle={dict.faq.subtitle}
    items={dict.faq.items.map((f) => ({ title: f.question, description: f.answer }))}
  />

  <CallToAction
    id="contact"
    actions={[
      { variant: 'primary', text: dict.cta.primaryCta, href: '/contact', icon: 'tabler:calendar-event' },
      { text: dict.cta.secondaryCta, href: 'mailto:hello@cafetatek.com?subject=About', icon: 'tabler:mail' }
    ]}
  >
    <Fragment slot="title">{dict.cta.title}</Fragment>
    <Fragment slot="subtitle">
      {dict.cta.subtitle}
      <br class="hidden md:inline" />
      <span class="block mt-4 text-xs font-medium tracking-widest uppercase text-muted dark:text-slate-400">
        {dict.cta.note}
      </span>
    </Fragment>
  </CallToAction>
</CafetatekLayout>
