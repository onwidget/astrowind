
---
import Layout from "~/layouts/PageLayout.astro";
import Hero from "~/components/widgets/Hero.astro";
import Stats from "~/components/widgets/Stats.astro";
import Features2 from "~/components/widgets/Features2.astro";
import Steps2 from "~/components/widgets/Steps2.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";

const metadata = { title: "About Us" };
---

<Layout metadata={metadata}>
  <Hero tagline="About Codemyc">
    <Fragment slot="bg">
      <div class="absolute inset-0 codemyc-hero-bg"></div>
    </Fragment>
    <Fragment slot="title">
      <span class="text-white">Built on expertise.</span><br />
      <span class="text-cyan-400">Driven by outcomes.</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-slate-300">
        Codemyc was founded on a belief that great technology outcomes require great people, not great headcount.
        We are a boutique studio of senior professionals who take deep pride in the quality and impact of our work.
      </span>
    </Fragment>
  </Hero>

  <!-- STATS -->
  <Stats
    title="Codemyc by the numbers"
    stats={[
      { title: "Projects Delivered", amount: "10+" },
      { title: "Years of Experience", amount: "5+" },
      { title: "Certified Staff", amount: "100%" },
      { title: "Client Satisfaction", amount: "100%" },
    ]}
  />

  <!-- STORY -->
  <section class="py-16 md:py-20 px-4 sm:px-6 max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-sm font-bold tracking-widest uppercase text-cyan-600 dark:text-cyan-400 mb-3">Our Story</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">Why we built Codemyc</h2>
        <div class="space-y-4 text-muted leading-relaxed">
          <p>Codemyc was born out of a frustration shared by many: too many technology projects fail not because of missing technology, but because of missing expertise. Generic agencies with junior staff, offshore teams with thin accountability, and bloated consultancies with too many layers between the client and the work.</p>
          <p>We built Codemyc to be the antidote. A studio where every professional is genuinely senior in their field. Where clients talk directly to the people doing the work. Where outcomes matter more than timesheets.</p>
          <p>Starting with Orlando and a small, hand-picked group of specialists, we have grown deliberately, adding people only when we find professionals who share our standards, our ownership mindset, and our commitment to honest, high-quality work.</p>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-2xl">
        <img
          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80"
          alt="Codemyc team at work"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <Steps2
    title="What we stand for"
    subtitle="These are not aspirational values posted on a wall. They are the operating principles that guide every decision, every conversation, and every line of code at Codemyc."
    items={[
      {
        title: "Expertise is non-negotiable",
        description: "We only take on work our team has genuine depth in. We will refer you elsewhere before we pretend to know something we do not.",
        icon: "tabler:certificate",
      },
      {
        title: "Radical transparency",
        description: "We tell you the truth about timelines, complexity, and risk. No sugar-coating, no over-promising. You deserve an honest partner.",
        icon: "tabler:eye",
      },
      {
        title: "Ownership over excuses",
        description: "When something does not go as planned, we take responsibility, communicate immediately, and fix it. We do not point fingers.",
        icon: "tabler:shield-check",
      },
    ]}
  />

  <!-- ACHIEVEMENTS -->
  <Steps2
    title="What we have achieved"
    subtitle="A small team, a high bar, and a track record of delivering where others have struggled."
    isReversed
    items={[
      {
        title: "Government-grade portals delivered on time",
        description: "Multiple public sector web portals delivered meeting strict compliance, accessibility, and security standards, all on time and within budget.",
        icon: "tabler:building-community",
      },
      {
        title: "Mobile apps serving thousands of daily users",
        description: "Mobile applications live on the App Store and Play Store with strong ratings, built by our senior mobile engineering team.",
        icon: "tabler:device-mobile",
      },
      {
        title: "Data projects that changed leadership decisions",
        description: "Analytics and BI implementations that gave leadership teams real-time visibility and measurably improved their decision-making quality.",
        icon: "tabler:chart-line",
      },
    ]}
    callToAction={{
      text: "See Our Services",
      href: "/services",
    }}
  />

  <!-- LOCATIONS / REMOTE -->
  <Features2
    title="Where we operate"
    tagline="Reach"
    subtitle="Codemyc operates as a distributed-first studio. Our professionals work remotely and collaborate across time zones, enabling us to serve clients anywhere."
    columns={3}
    items={[
      {
        title: "Latin America",
        description: "Our founding team and core of technical professionals are based across Latin America, with deep roots in the regional tech ecosystem.",
        icon: "tabler:map-pin",
      },
      {
        title: "North America",
        description: "We serve clients in the United States and Canada, with team members operating in aligned time zones for real-time collaboration.",
        icon: "tabler:map-pin",
      },
      {
        title: "Remote-first globally",
        description: "We work asynchronously and synchronously as needed. No time zone is a barrier to a great working relationship.",
        icon: "tabler:world",
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </Features2>

  <CallToAction
    actions={[
      { variant: "primary", text: "Work With Us", href: "/contact", icon: "tabler:send" },
      { text: "Meet the Team", href: "/team" },
    ]}
  >
    <Fragment slot="title">
      We are more than a vendor.<br /><span class="text-cyan-500">We are your technical partners.</span>
    </Fragment>
    <Fragment slot="subtitle">
      When you work with Codemyc, you get professionals who are invested in your success, not just your invoice.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 codemyc-hero-bg"></div>
    </Fragment>
  </CallToAction>
</Layout>
