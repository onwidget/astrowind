---
import SiteLayout from '~/layouts/SiteLayout.astro';
import MyceliumCanvas from '~/components/site/MyceliumCanvas.astro';
import PartnersDiagram from '~/components/site/PartnersDiagram.astro';

const metadata = {
  title: 'About',
  description:
    'Why Codemyc exists, what the name means, and how a small senior team in Montevideo ships software for governments, companies, and founders across the Americas.',
};

const values = [
  {
    t: 'Senior, not self-important',
    d: 'We show credentials and delivered work instead of adjectives. Confidence is earned; we don’t announce it.',
  },
  {
    t: 'Direct',
    d: 'You hear what something costs, how long it takes, and what could go wrong — from the engineers, in the first conversation.',
  },
  {
    t: 'Warm',
    d: 'Small team, real people, real names. Working with us should feel like meeting us, not reading a brochure.',
  },
  {
    t: 'Craft-obsessed',
    d: 'We care about the boring parts — accessibility, security, maintainability — because that’s what battle-tested actually means.',
  },
  {
    t: 'Connective',
    d: 'We make systems, teams, and ideas work together. It’s in the name.',
  },
];
---

<SiteLayout metadata={metadata}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-edge">
    <MyceliumCanvas />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/40 via-transparent to-ink"></div>
    <div class="container-site relative z-10 pt-40 pb-24">
      <p class="label-mono" data-reveal>About</p>
      <h1 class="heading-display mt-5 max-w-3xl text-4xl md:text-6xl" data-reveal>
        The team your CTO friend <span class="text-spore">would recommend.</span>
      </h1>
    </div>
  </section>

  <!-- Story -->
  <section>
    <div class="container-site grid gap-14 py-24 md:grid-cols-[3fr_2fr]">
      <div class="space-y-6 text-lg leading-relaxed text-haze">
        <p data-reveal>
          Codemyc started with two engineers in Montevideo who kept seeing the same thing from opposite sides: companies
          paying agency prices for junior work, and senior Latin American engineers doing world-class work without their
          names on it.
        </p>
        <p data-reveal>
          <span class="text-mist">Orlando</span> leads engineering — architecture, web, mobile, and the infrastructure that
          keeps it honest. <span class="text-mist">Diana</span> owns institutional and government software — the platforms
          where compliance and accessibility aren’t negotiable, proven across Uruguay’s national portal network. Around them
          is a network of practicing specialists they’ve already shipped with.
        </p>
        <p data-reveal>
          We stayed deliberately small. Every person on your project is someone whose name you know, whose work you can
          see, and who answers when you write. That’s not a limitation we manage — it’s the product.
        </p>
      </div>
      {/* Founders slot — a candid photo of Orlando and Diana goes here when we have one (docs/photo-slots.md) */}
      <PartnersDiagram />
    </div>
  </section>

  <!-- Name story -->
  <section class="border-t border-edge bg-deep bg-dotgrid">
    <div class="container-site py-24 md:py-32">
      <p class="label-mono" data-reveal>Why “Codemyc”</p>
      <p class="heading-display mt-6 max-w-4xl text-3xl leading-snug md:text-5xl" data-reveal>
        Code + <span class="text-spore">myc</span> — as in mycelium: the underground network that connects and nourishes
        entire ecosystems.
      </p>
      <div class="mt-10 grid max-w-4xl gap-8 md:grid-cols-3" data-reveal-group>
        <p class="text-sm leading-relaxed text-haze">
          Mycelium doesn’t dominate the forest — <span class="text-mist">it makes the forest work.</span>
        </p>
        <p class="text-sm leading-relaxed text-haze">
          It connects things that couldn’t talk to each other. <span class="text-mist">So do we.</span>
        </p>
        <p class="text-sm leading-relaxed text-haze">
          It grows where it’s needed and scales with the ecosystem.
          <span class="text-mist">Low ego, high connectivity, lasting impact.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="border-t border-edge">
    <div class="container-site py-24">
      <p class="label-mono" data-reveal>How we work</p>
      <h2 class="heading-display mt-4 text-3xl md:text-5xl" data-reveal>Five traits, every engagement</h2>
      <div
        class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-edge bg-edge md:grid-cols-2 lg:grid-cols-5"
        data-reveal-group
      >
        {
          values.map(({ t, d }) => (
            <div class="bg-moss p-7">
              <h3 class="font-display text-base font-semibold text-spore">{t}</h3>
              <p class="mt-3 text-sm leading-relaxed text-haze">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Nearshore -->
  <section class="border-t border-edge bg-deep">
    <div class="container-site grid gap-12 py-24 md:grid-cols-2">
      <div>
        <p class="label-mono" data-reveal>Nearshore, structurally</p>
        <h2 class="heading-display mt-4 text-3xl md:text-4xl" data-reveal>
          Montevideo, Uruguay. <span class="text-spore">Your time zone.</span>
        </h2>
        <p class="mt-6 leading-relaxed text-haze" data-reveal>
          We work GMT−3 — overlapping the full business day of the Americas and most of the European afternoon. Every
          member of the team holds C2-level English certification: meetings, documentation, code review, and contracts
          happen in fluent English, with no relay and no translation layer.
        </p>
        <p class="mt-4 leading-relaxed text-haze" data-reveal>
          The result is a simple equation: <span class="text-mist"
            >US-agency capability, nearshore economics, zero friction.</span
          >
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4" data-reveal-group>
        <div class="card-moss p-7">
          <p class="font-display text-3xl font-semibold text-spore">GMT−3</p>
          <p class="label-mono mt-2">Same hours as the Americas</p>
        </div>
        <div class="card-moss p-7">
          <p class="font-display text-3xl font-semibold text-spore">C2</p>
          <p class="label-mono mt-2">Certified English, whole team</p>
        </div>
        <div class="card-moss p-7">
          <p class="font-display text-3xl font-semibold text-spore">0</p>
          <p class="label-mono mt-2">Account managers between us</p>
        </div>
        <div class="card-moss p-7">
          <p class="font-display text-3xl font-semibold text-spore">100%</p>
          <p class="label-mono mt-2">Senior, named, accountable</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-edge">
    <div class="container-site py-24 text-center">
      <h2 class="heading-display mx-auto max-w-2xl text-3xl md:text-5xl" data-reveal>
        Meet the people behind the network
      </h2>
      <div class="mt-8 flex justify-center gap-4" data-reveal>
        <a href="/team" class="btn-spore">The team</a>
        <a href="/contact" class="btn-ghost">Start a project</a>
      </div>
    </div>
  </section>
</SiteLayout>
