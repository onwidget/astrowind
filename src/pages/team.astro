---
import SiteLayout from '~/layouts/SiteLayout.astro';
import MyceliumCanvas from '~/components/site/MyceliumCanvas.astro';
import MemberGlyph from '~/components/site/MemberGlyph.astro';
import MemberPhoto from '~/components/site/MemberPhoto.astro';
import { coreTeam } from '~/data/team';

const metadata = {
  title: 'The Network',
  description:
    'Codemyc is a network, not an org chart: a tight senior core plus trusted specialists who align into purpose-built teams per engagement.',
};

const extended = [
  { role: 'Mobile engineering', note: 'Flutter & native specialists for product-grade releases.' },
  { role: 'Data & analytics', note: 'Pipelines, dashboards, and decision-grade reporting.' },
  { role: 'UX & product design', note: 'Interfaces that survive contact with real users.' },
  { role: 'DevOps & cloud', note: 'Infrastructure, CI/CD, and observability at production standard.' },
];
---

<SiteLayout metadata={metadata}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-edge">
    <MyceliumCanvas />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/40 via-transparent to-ink"></div>
    <div class="container-site relative z-10 pt-40 pb-24">
      <p class="label-mono" data-reveal>The network</p>
      <h1 class="heading-display mt-5 max-w-3xl text-4xl md:text-6xl" data-reveal>
        Not an org chart. <span class="text-spore">A roster.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-haze" data-reveal>
        A tight core of partners plus actively practicing, top-of-their-field specialists who align into purpose-built
        teams — formed fast, shipped, and dissolved when the job’s done. Every person on your project is someone whose
        name you know, whose work you can see, and who answers when you write.
      </p>
    </div>
  </section>

  <!-- Core -->
  <section>
    <div class="container-site py-24">
      <p class="label-mono" data-reveal>The core</p>
      <h2 class="heading-display mt-4 text-3xl md:text-5xl" data-reveal>Partners on every engagement</h2>

      <div class="mt-14 space-y-10">
        {
          coreTeam.map((m, i) => (
            <a
              href={`/${m.slug}`}
              class="card-moss group grid overflow-hidden transition-all hover:border-spore/40 md:grid-cols-[2fr_3fr]"
              data-reveal
            >
              {/* Portrait slot — set `photo.image` in src/data/team.ts and the real photo replaces the glyph */}
              {m.photo.image ? (
                <MemberPhoto
                  image={m.photo.image}
                  alt={`Portrait of ${m.name}`}
                  focalPosition={m.photo.focalPosition}
                  class:list={[
                    'aspect-[4/3] rounded-none border-0 md:aspect-auto md:border-r',
                    i % 2 === 1 && 'md:order-last md:border-l md:border-r-0',
                  ]}
                />
              ) : (
                <MemberGlyph
                  name={m.name}
                  slug={m.slug}
                  class:list={[
                    'aspect-[4/3] rounded-none border-0 border-edge md:aspect-auto md:border-r',
                    i % 2 === 1 && 'md:order-last md:border-l md:border-r-0',
                  ]}
                />
              )}
              <div class="flex flex-col justify-center p-8 md:p-12">
                <p class="label-mono text-spore">{m.role}</p>
                <h3 class="font-display mt-2 text-3xl font-semibold text-mist">{m.name}</h3>
                <p class="mt-4 leading-relaxed text-haze">{m.owns}</p>
                <ul class="mt-6 flex flex-wrap gap-2">
                  {m.focus.slice(0, 4).map((f) => (
                    <li class="rounded-full border border-edge px-3 py-1 font-mono text-[11px] text-haze">{f}</li>
                  ))}
                </ul>
                <span class="label-mono mt-8 text-mist transition-colors group-hover:text-spore">
                  Full profile · /{m.slug} →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Extended network -->
  <section class="border-t border-edge bg-deep bg-dotgrid">
    <div class="container-site py-24">
      <p class="label-mono" data-reveal>The extended network</p>
      <h2 class="heading-display mt-4 max-w-2xl text-3xl md:text-5xl" data-reveal>
        Specialists we’ve shipped with before
      </h2>
      <p class="mt-6 max-w-2xl text-haze" data-reveal>
        When a project needs more hands, we don’t hire strangers — we activate vetted professionals Orlando and Diana
        have already delivered with. Each joins for exactly the part of the project where their craft matters.
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {
          extended.map(({ role, note }) => (
            <div class="card-moss p-7">
              <h3 class="font-display text-base font-semibold text-mist">{role}</h3>
              <p class="mt-2 text-sm leading-relaxed text-haze">{note}</p>
            </div>
          ))
        }
      </div>

      <p class="label-mono mt-10" data-reveal>More member profiles coming to this page as we publish them.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-edge">
    <div class="container-site py-24 text-center">
      <h2 class="heading-display mx-auto max-w-2xl text-3xl md:text-5xl" data-reveal>
        Want this team on your problem?
      </h2>
      <div class="mt-8" data-reveal>
        <a href="/contact" class="btn-spore">Start a project</a>
      </div>
    </div>
  </section>
</SiteLayout>
