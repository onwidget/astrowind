---
import SiteLayout from '~/layouts/SiteLayout.astro';

const metadata = { title: 'Page not found' };
---

<SiteLayout metadata={metadata}>
  <section class="flex min-h-screen items-center bg-dotgrid">
    <div class="container-site py-32 text-center">
      <p class="font-mono text-sm text-spore">404</p>
      <h1 class="heading-display mt-4 text-4xl md:text-6xl">This node doesn’t exist.</h1>
      <p class="mx-auto mt-6 max-w-md text-haze">
        The network has no path to this page. Let’s get you back to one that connects.
      </p>
      <div class="mt-10">
        <a href="/" class="btn-spore">Back to the homepage</a>
      </div>
    </div>
  </section>
</SiteLayout>
