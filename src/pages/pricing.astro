---
import CafetatekLayout from '~/layouts/CafetatekLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { t, type Locale } from '~/utils/translations';

const locale: Locale = 'en';
const dict = t(locale);

const metadata = {
  title: dict.nav.engagement,
};
---

<CafetatekLayout locale={locale} metadata={metadata}>
  <Hero
    id="pricing-hero"
    tagline={dict.engagement.eyebrow}
    actions={[
      { variant: 'primary', text: dict.cta.primaryCta, href: '/contact', icon: 'tabler:calendar-event' }
    ]}
  >
    <Fragment slot="title">{dict.engagement.title}</Fragment>
    <Fragment slot="subtitle">{dict.engagement.subtitle}</Fragment>
  </Hero>

  <Features2
    id="engagement"
    tagline={dict.engagement.eyebrow}
    title="Four ways to work with us"
    subtitle="Pick the model that matches your stage and risk profile. Every engagement ships with a published scope, a fixed price, and a 30-day warranty."
    items={dict.engagement.items.map((e) => ({
      title: e.title,
      description: `${e.description} · ${e.duration}`,
      icon: 'tabler:briefcase'
    }))}
  />

  <CallToAction
    id="contact"
    actions={[
      { variant: 'primary', text: dict.cta.primaryCta, href: '/contact', icon: 'tabler:calendar-event' },
      { text: dict.cta.secondaryCta, href: 'mailto:hello@cafetatek.com?subject=Pricing%20brief', icon: 'tabler:mail' }
    ]}
  >
    <Fragment slot="title">Not sure which model fits?</Fragment>
    <Fragment slot="subtitle">
      Book a 30-min discovery call. We will recommend the model that matches your stage, your team, and your risk profile — not the one that bills the most.
      <br class="hidden md:inline" />
      <span class="block mt-4 text-xs font-medium tracking-widest uppercase text-muted dark:text-slate-400">
        {dict.cta.note}
      </span>
    </Fragment>
  </CallToAction>
</CafetatekLayout>
