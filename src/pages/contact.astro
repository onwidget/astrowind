---
import CafetatekLayout from '~/layouts/CafetatekLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Contact from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

import { t, type Locale } from '~/utils/translations';

const locale: Locale = 'en';
const dict = t(locale);

const metadata = {
  title: 'Contact',
};
---

<CafetatekLayout locale={locale} metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Let's turn your next technology challenge into a clear plan."
  >
    <Fragment slot="subtitle">
      Share what you are building, improving, or exploring. Cafetatek is ready to listen and help you identify the next practical step.
    </Fragment>
  </HeroText>

  <Contact
    id="form"
    title="Drop us a message"
    subtitle="For quicker answers, our FAQ on the About page may already cover it. If not, our senior team responds within 1 business day."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name'
      },
      {
        type: 'email',
        name: 'email',
        label: 'Work email'
      }
    ]}
    textarea={{
      label: 'What is the situation?'
    }}
    disclaimer={{
      label: 'By submitting this form, you agree to the collection of your contact information for the purpose of replying to your enquiry.'
    }}
    description="Replies within 1 business day · No sales pressure · Senior engineer on every call"
    button="Send your message"
  />

  <Features2
    title="Other ways to reach us"
    items={[
      {
        title: 'For technical enquiries',
        description: 'Email the senior team directly at hello@cafetatek.com. We triage every request within 1 business day.',
        icon: 'tabler:mail'
      },
      {
        title: 'For procurement and legal',
        description: 'Same address. We can provide a signed DPA, security questionnaire answers, and standard MSA templates within 48 hours.',
        icon: 'tabler:file-text'
      },
      {
        title: 'For partners and integrators',
        description: 'If you are a cloud provider, an agency, or an SI looking to co-deliver, get in touch. We work with a small, vetted partner network.',
        icon: 'tabler:users-plus'
      }
    ]}
  />
</CafetatekLayout>
