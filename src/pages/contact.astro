
---
import Layout from "~/layouts/PageLayout.astro";
import Hero from "~/components/widgets/Hero.astro";
import Contact from "~/components/widgets/Contact.astro";
import Features2 from "~/components/widgets/Features2.astro";

const metadata = { title: "Contact" };
---

<Layout metadata={metadata}>
  <Hero tagline="Contact">
    <Fragment slot="bg">
      <div class="absolute inset-0 codemyc-hero-bg"></div>
    </Fragment>
    <Fragment slot="title">
      <span class="text-white">Let us talk about</span><br />
      <span class="text-cyan-400">your next project</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-slate-300">
        No forms that go into the void. No automated responses. When you reach out to Codemyc,
        a senior professional reads your message and responds personally within one business day.
      </span>
    </Fragment>
  </Hero>

  <!-- WHAT TO EXPECT -->
  <Features2
    tagline="What happens next"
    title="A straightforward conversation"
    subtitle="We keep our sales process as lean as our engineering."
    columns={3}
    items={[
      {
        title: "1. You reach out",
        description: "Send us a message describing your challenge, your timeline, and what a successful outcome looks like for you.",
        icon: "tabler:send",
      },
      {
        title: "2. We respond within 24 hours",
        description: "A senior Codemyc professional will review your message and respond with relevant questions or a proposed call time.",
        icon: "tabler:clock",
      },
      {
        title: "3. Discovery call",
        description: "A focused 30-minute call to understand your needs, answer your questions, and determine whether there is a good fit.",
        icon: "tabler:phone-call",
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </Features2>

  <!-- CONTACT FORM -->
  <Contact
    id="form"
    title="Send us a message"
    subtitle="Tell us about your project and we will be in touch promptly."
    inputs={[
      {
        type: "text",
        name: "name",
        label: "Your name",
        placeholder: "John Smith",
      },
      {
        type: "email",
        name: "email",
        label: "Email address",
        placeholder: "john@company.com",
      },
    ]}
    textarea={{
      label: "Tell us about your project",
      name: "message",
      placeholder: "Describe your challenge, what you are trying to achieve, your rough timeline, and any relevant technical context...",
      rows: 6,
    }}
    disclaimer={{
      label: "By submitting this form, you agree that Codemyc may contact you regarding your enquiry. We respect your privacy and will never share your information.",
    }}
    description="We aim to respond to all enquiries within one business day."
  />

  <!-- ALTERNATIVE CONTACT -->
  <Features2
    tagline="Other ways to reach us"
    title="Prefer a direct line?"
    columns={2}
    items={[
      {
        title: "LinkedIn",
        description: "Connect with us on LinkedIn and send a direct message. We actively monitor our inbox there.",
        icon: "tabler:brand-linkedin",
      },
      {
        title: "Email directly",
        description: "Prefer email? Reach us at hello@codemyc.com and a team member will respond within 24 hours.",
        icon: "tabler:mail",
      },
    ]}
  />
</Layout>
