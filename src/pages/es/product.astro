---
import CafetatekLayout from '~/layouts/CafetatekLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { t, type Locale } from '~/utils/translations';

const locale: Locale = 'es';
const dict = t(locale);
const sap = dict.elixa.sapFoundation;

const metadata = {
  title: 'Elixa Multi-Migration Platform',
  description: dict.elixa.subtitle,
};
---

<CafetatekLayout locale={locale} metadata={metadata}>
  <Hero
    id="product-hero"
    tagline={dict.elixa.eyebrow}
    actions={[
      { variant: 'primary', text: dict.elixa.primaryCta, href: '/es/contact', icon: 'tabler:player-play' },
      { text: dict.elixa.secondaryCta, href: '#sap-model', icon: 'tabler:book' },
    ]}
  >
    <Fragment slot="title">{dict.elixa.title}</Fragment>
    <Fragment slot="subtitle">{dict.elixa.subtitle}</Fragment>
  </Hero>

  <div class="bg-muted/40 border-y">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8">
      <p class="text-secondary text-sm font-bold tracking-wide uppercase mb-3">{dict.elixa.whyBuiltTitle}</p>
      <p class="text-foreground text-lg leading-relaxed text-balance">{dict.elixa.whyBuiltBody}</p>
    </div>
  </div>

  <section id="sap-model" class="py-16 sm:py-20 lg:py-24" aria-labelledby="sap-model-title">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-secondary text-sm font-bold tracking-wide uppercase mb-3">{sap.eyebrow}</p>
      <h2 id="sap-model-title" class="text-3xl md:text-4xl font-bold tracking-tight text-balance mb-4">
        {sap.title}
      </h2>
      <p class="text-muted text-lg leading-relaxed text-balance mb-10">{sap.subtitle}</p>

      <div class="rounded-lg border border-[#ffffff29] bg-white dark:bg-slate-900 p-6 sm:p-8 mb-10">
        <h3 class="text-xl font-bold mb-3">{sap.painTitle}</h3>
        <p class="text-muted leading-relaxed">{sap.painBody}</p>
      </div>
    </div>

    <Features2
      id="sap-adapters"
      columns={3}
      tagline={sap.adaptersTitle}
      title={sap.adaptersSubtitle}
      items={sap.adapters.map((a, i) => ({
        title: a.title,
        description: a.description,
        icon: ['tabler:database', 'tabler:building-warehouse', 'tabler:building-store'][i] ?? 'tabler:database',
      }))}
    />

    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-4 mb-12">
      <h3 class="text-2xl font-bold tracking-tight mb-4">{sap.engineTitle}</h3>
      <p class="text-muted text-lg leading-relaxed">{sap.engineBody}</p>
    </div>

    <Features2
      id="sap-close"
      columns={3}
      tagline={sap.closeTitle}
      title={sap.closeSubtitle}
      items={sap.closeItems.map((item) => ({
        title: item.title,
        description: item.description,
        icon: 'tabler:circle-check-filled',
      }))}
    />
  </section>

  <Steps
    id="how-it-works"
    tagline={dict.elixa.howItWorksTagline}
    title={dict.elixa.howItWorksTitle}
    subtitle={dict.elixa.howItWorksSubtitle}
    items={dict.elixa.steps.map((s, i) => ({
      title: `Paso ${i + 1}: <span class="font-medium">${s.title}</span>`,
      description: s.description,
      icon: ['tabler:clipboard-list', 'tabler:layout-grid', 'tabler:shield-check', 'tabler:check'][i] ?? 'tabler:check',
    }))}
  />

  <Features2
    id="features"
    tagline={dict.elixa.eyebrow}
    title={dict.elixa.featuresTitle}
    items={dict.elixa.features.map((f) => ({
      title: f,
      description: '',
      icon: 'tabler:circle-check-filled',
    }))}
  />

  <CallToAction
    id="contact"
    actions={[
      { variant: 'primary', text: dict.elixa.primaryCta, href: '/es/contact', icon: 'tabler:calendar-event' },
      { text: dict.elixa.secondaryCta, href: '#sap-model', icon: 'tabler:mail' },
    ]}
  >
    <Fragment slot="title">{dict.elixa.demoTitle}</Fragment>
    <Fragment slot="subtitle">
      {dict.elixa.demoSubtitle}
      <br class="hidden md:inline" />
      <span class="block mt-4 text-xs font-medium tracking-widest uppercase text-muted dark:text-slate-400">
        {dict.cta.note}
      </span>
    </Fragment>
  </CallToAction>
</CafetatekLayout>
