---
import CafetatekLayout from '~/layouts/CafetatekLayout.astro';
import CapabilitiesCarousel from '~/components/widgets/CapabilitiesCarousel.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';

import { t, type Locale } from '~/utils/translations';

const locale: Locale = 'es';
const dict = t(locale);

const pillars = dict.pillars.items;

const pillarAnchors = pillars.map((_, i) => `pillar-${i + 1}`);

const metadata = {
  title: dict.pillars.title,
  ignoreTitleTemplate: true,
};
---

<CafetatekLayout locale={locale} metadata={metadata}>
  <Hero
    id="services-hero"
    tagline={dict.pillars.eyebrow}
    actions={[
      { variant: 'primary', text: dict.cta.primaryCta, href: '/es/contact', icon: 'tabler:calendar-event' },
      { text: 'Saltar a un pilar', href: '#pillars-overview', icon: 'tabler:list' }
    ]}
  >
    <Fragment slot="title">{dict.pillars.title}</Fragment>
    <Fragment slot="subtitle">{dict.pillars.subtitle}</Fragment>
  </Hero>

  <!-- Carrusel de capacidades — slides verticales que reflejan <CapabilitiesSection /> -->
  <CapabilitiesCarousel
    eyebrow={dict.pillars.eyebrow}
    title={dict.pillars.title}
    subtitle={dict.pillars.subtitle}
    items={pillars.map((p) => ({
      title: p.title,
      description: p.description,
      bullets: p.bullets,
      icon: p.icon,
      duration: p.duration
    }))}
  />

  <!-- Vista general: índice de los 5 pilares -->
  <Features
    id="pillars-overview"
    tagline="Cinco pilares"
    title={dict.pillars.title}
    subtitle={dict.pillars.subtitle}
    columns={3}
    items={pillars.map((it, i) => ({
      title: `0${i + 1}. ${it.title}`,
      description: it.description,
      icon: it.icon,
      callToAction: { text: `Ver pilar 0${i + 1}`, href: `#${pillarAnchors[i]}` }
    }))}
  />

  <!-- Profundización: cada pilar en detalle -->
  {pillars.map((pillar, i) => (
    <section id={pillarAnchors[i]} class:list={[
      'py-12 sm:py-16 lg:py-24',
      i % 2 === 0 ? 'bg-background' : 'bg-muted/40',
      i > 0 ? 'section-divider' : ''
    ]}>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <!-- Cabecera del pilar -->
        <div class="mx-auto max-w-3xl text-center mb-10 sm:mb-14">
          <div class="inline-flex items-center gap-3 mb-4">
            <span class="methodology-tag rounded-full px-3 py-1 text-xs font-semibold tracking-widest uppercase">
              Pilar 0{i + 1}
            </span>
            <span class="text-muted-foreground text-xs font-semibold tracking-widest uppercase">
              · {pillar.duration}
            </span>
          </div>
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="pillar-icon flex items-center justify-center w-14 h-14 rounded-full">
              <Icon name={pillar.icon} class="w-7 h-7" />
            </div>
          </div>
          <h2 class="text-section text-balance">{pillar.title}</h2>
          <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-lg sm:text-xl leading-relaxed">
            {pillar.description}
          </p>
        </div>

        <!-- Call-out de tarea aburrida + precio -->
        <div class="mx-auto max-w-4xl mb-10 sm:mb-14">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="card-hover bg-muted/60 border border-border/40 rounded-xl p-6">
              <p class="accent-rule text-secondary text-xs font-bold tracking-wide uppercase inline-block mb-2">Tarea aburrida que automatizamos</p>
              <p class="text-foreground text-base leading-relaxed">{pillar.boringTask}</p>
            </div>
            <div class="card-hover bg-muted/60 border border-border/40 rounded-xl p-6">
              <p class="accent-rule text-secondary text-xs font-bold tracking-wide uppercase inline-block mb-2">Engagement</p>
              <p class="text-foreground text-base leading-relaxed">
                <strong class="text-primary">{pillar.duration}</strong>
                <span class="text-muted-foreground"> · </span>
                <strong class="text-primary">{pillar.priceBand}</strong>
                <span class="text-muted-foreground text-sm block mt-1">Alcance fijo · precio por outcome · garantía de 30 días</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Sub-servicios -->
        <div class="mx-auto max-w-5xl mb-10 sm:mb-14">
          <p class="accent-rule text-secondary text-sm font-bold tracking-wide uppercase inline-block mb-6">Qué incluye</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {pillar.subServices.map((ss) => (
              <article class="pillar-card card-hover group bg-background border border-border/40 rounded-xl p-6">
                <div class="flex items-start gap-4">
                  <div class="methodology-tag rounded-full w-10 h-10 flex items-center justify-center text-sm font-bold shrink-0">
                    {ss.letter}
                  </div>
                  <div>
                    <h3 class="text-lg font-bold leading-tight mb-2">{ss.title}</h3>
                    <p class="text-muted-foreground text-sm leading-relaxed">{ss.description}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Deliverables -->
        <div class="mx-auto max-w-4xl">
          <p class="accent-rule text-secondary text-sm font-bold tracking-wide uppercase inline-block mb-4">Qué entregas</p>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
            {pillar.deliverables.map((d) => (
              <li class="flex items-start gap-2 text-muted-foreground text-sm">
                <span class="text-primary mt-1 inline-block w-1.5 h-1.5 rounded-full bg-primary shrink-0" />
                <span>{d}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 text-center">
            <a
              href={`/es/contact?pillar=0${i + 1}`}
              class="inline-flex items-center gap-2 text-primary font-semibold hover:underline"
            >
              <span>Conversar sobre el pilar 0{i + 1}</span>
              <Icon name="tabler:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <CallToAction
    id="contact"
    actions={[
      { variant: 'primary', text: dict.cta.primaryCta, href: '/es/contact', icon: 'tabler:calendar-event' },
      { text: dict.cta.secondaryCta, href: 'mailto:hello@cafetatek.com?subject=Pilares%20brief', icon: 'tabler:mail' }
    ]}
  >
    <Fragment slot="title">{dict.cta.title}</Fragment>
    <Fragment slot="subtitle">
      {dict.cta.subtitle}
      <br class="hidden md:inline" />
      <span class="block mt-4 text-xs font-medium tracking-widest uppercase text-muted dark:text-slate-400">
        {dict.cta.note}
      </span>
    </Fragment>
  </CallToAction>
</CafetatekLayout>
