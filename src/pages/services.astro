---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { coreTeam } from '~/data/team';

const metadata = {
  title: 'Services',
  description:
    'Institutional platforms, web and mobile applications, AI integration, cloud and observability, and system integration — delivered by a senior nearshore team in your time zone.',
};

const services = [
  {
    id: 'institutional',
    title: 'Institutional & government platforms',
    lead: 'Public-sector software is our home turf: platforms where accessibility, security, and uptime are obligations, not features.',
    items: [
      'High-traffic government portals and intranets (Drupal 9/10/11)',
      'Large-scale CMS migrations with full content-integrity validation',
      'WCAG 2.1 accessibility auditing and remediation',
      'Enterprise search (Apache Solr) and performance optimization',
      'Compliance-ready documentation for procurement processes',
    ],
    proof: 'Proof: 67+ portals on Uruguay’s national platform, the official site of Montevideo, and full D7→D10 departmental migrations.',
  },
  {
    id: 'web',
    title: 'Web applications',
    lead: 'Bespoke products and platforms, architecture-first, built by the same seniors who scoped them.',
    items: [
      'Product development from discovery to launch',
      'Frontend engineering (React, TypeScript, web components)',
      'Backend & APIs (Node.js, PHP/Symfony, Python)',
      'Headless and decoupled CMS architectures',
      'Testing as a habit: unit, end-to-end, and performance suites',
    ],
    proof: 'Proof: frontend leadership on the GeneXus web low-code IDE; production platforms across logistics, education, and energy.',
  },
  {
    id: 'mobile',
    title: 'Mobile applications',
    lead: 'Cross-platform apps with production architecture — not prototypes wearing a release number.',
    items: [
      'Flutter apps with clean architecture and proven patterns',
      'Firebase backends, analytics, and crash monitoring',
      'Release pipelines (Codemagic, App/Play Store distribution)',
      'Native SDK integration, including ML and biometrics',
    ],
    proof: 'Proof: technical lead on ECPASS, a biometric airport check-in and boarding app.',
  },
  {
    id: 'ai',
    title: 'AI integration',
    lead: 'We make AI do real work on your data and systems — measured, secured, and maintained like any other production software.',
    items: [
      'RAG pipelines and vector search over your content',
      'Agents and MCP servers operating on real business systems',
      'Conversational interfaces (web, WhatsApp, Telegram)',
      'Pragmatic model selection and cost control',
    ],
    proof: 'Proof: natural-language data operations on production CMS platforms via MCP; document classification with NLP.',
  },
  {
    id: 'cloud',
    title: 'Cloud, DevOps & observability',
    lead: 'Infrastructure your team can operate, and telemetry that tells you what is actually happening.',
    items: [
      'Google Cloud and AWS architecture (Google ACE certified)',
      'Containerization and orchestration (Docker, Swarm)',
      'CI/CD with quality gates: tests, performance, accessibility, SEO',
      'Full observability stacks: OpenTelemetry, Grafana, Prometheus, Loki, Tempo',
    ],
    proof: 'Proof: an observability platform we built runs in production across multiple client environments — and helps close their sales.',
  },
  {
    id: 'integration',
    title: 'System integration',
    lead: 'The mycelium specialty: making systems that couldn’t talk to each other, talk.',
    items: [
      'Legacy modernization (including IBM i / AS400 ecosystems)',
      'Third-party API integrations and SSO',
      'EDI processing and SOAP-to-REST conversion',
      'Data synchronization across heterogeneous platforms',
    ],
    proof: 'Proof: freight and logistics integrations spanning EDI, telematics APIs, and 40-year-old systems of record.',
  },
];
---

<SiteLayout metadata={metadata}>
  <!-- Hero -->
  <section class="border-b border-edge bg-deep bg-dotgrid">
    <div class="container-site pt-40 pb-20">
      <p class="label-mono" data-reveal>Capabilities</p>
      <h1 class="heading-display mt-5 max-w-3xl text-4xl md:text-6xl" data-reveal>
        What we build, <span class="text-spore">and the proof behind it</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-haze" data-reveal>
        Every capability below is backed by named, delivered work — not a stock-photo services grid. If your problem
        spans several of them, that’s what dynamic teams are for.
      </p>
    </div>
  </section>

  <!-- Service sections -->
  {
    services.map((s, i) => (
      <section id={s.id} class:list={['scroll-mt-24 border-b border-edge', i % 2 === 1 && 'bg-deep']}>
        <div class="container-site grid gap-10 py-20 md:grid-cols-[2fr_3fr]">
          <div data-reveal>
            <p class="font-mono text-sm text-spore">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="heading-display mt-3 text-3xl md:text-4xl">{s.title}</h2>
            <p class="mt-5 leading-relaxed text-haze">{s.lead}</p>
            <p class="label-mono mt-8 leading-relaxed normal-case tracking-normal text-spore-dim">{s.proof}</p>
          </div>
          <ul class="space-y-4 md:pt-10" data-reveal-group>
            {s.items.map((item) => (
              <li class="flex gap-4 rounded-xl border border-edge bg-moss px-6 py-4 text-sm text-mist/90">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-spore" aria-hidden="true" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <!-- How we price -->
  <section class="border-b border-edge bg-deep bg-dotgrid">
    <div class="container-site py-24">
      <p class="label-mono" data-reveal>How we price</p>
      <h2 class="heading-display mt-4 max-w-2xl text-3xl md:text-5xl" data-reveal>
        Same seniority, smarter economics.
      </h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3" data-reveal-group>
        <div>
          <h3 class="font-display text-lg font-semibold text-mist">Nearshore by structure</h3>
          <p class="mt-3 text-sm leading-relaxed text-haze">
            We’re based in Latin America with near-zero overhead. The savings against US/EU agency rates are real and
            come from geography — never from junior substitutions.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-mist">You pay for the team you need</h3>
          <p class="mt-3 text-sm leading-relaxed text-haze">
            Teams are assembled per problem, so the quote covers the seniors doing the work — no project managers you
            didn’t ask for, no idle bench baked into the rate.
          </p>
        </div>
        <div>
          <h3 class="font-display text-lg font-semibold text-mist">Transparent from the first call</h3>
          <p class="mt-3 text-sm leading-relaxed text-haze">
            Scope, trade-offs, and a clear price before we start — and honest flags the moment anything threatens
            either. Fixed-scope or monthly engagement, your pick.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="container-site flex flex-col items-start gap-8 py-24 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="heading-display max-w-xl text-3xl md:text-4xl" data-reveal>
          Not sure which of these your problem is? That’s normal.
        </h2>
        <p class="mt-4 max-w-xl text-haze" data-reveal>
          Bring the problem as it actually is. {coreTeam[0].name.split(' ')[0]} and {coreTeam[1].name.split(' ')[0]}
          will tell you what it needs — including the parts that don’t need us.
        </p>
      </div>
      <a href="/contact" class="btn-spore shrink-0" data-reveal>Talk to the engineers</a>
    </div>
  </section>
</SiteLayout>
