
---
import Layout from "~/layouts/PageLayout.astro";
import Hero from "~/components/widgets/Hero.astro";
import Features2 from "~/components/widgets/Features2.astro";
import Content from "~/components/widgets/Content.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Steps from "~/components/widgets/Steps.astro";

const metadata = { title: "Services" };
---

<Layout metadata={metadata}>
  <Hero tagline="Services">
    <Fragment slot="bg">
      <div class="absolute inset-0 codemyc-hero-bg"></div>
    </Fragment>
    <Fragment slot="title">
      <span class="text-white">End-to-end technology services</span><br />
      <span class="text-cyan-400">delivered by specialists</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-slate-300">
        From government web portals to mobile applications, software architecture to data analytics,
        Codemyc provides senior-led professional services that move the needle for your business.
      </span>
    </Fragment>
    <Fragment slot="content">
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <a href="#institutional" class="px-4 py-2 rounded-full bg-white/10 text-white text-sm hover:bg-white/20 transition-colors border border-white/20">Institutional Portals</a>
        <a href="#mobile" class="px-4 py-2 rounded-full bg-white/10 text-white text-sm hover:bg-white/20 transition-colors border border-white/20">Mobile Apps</a>
        <a href="#architecture" class="px-4 py-2 rounded-full bg-white/10 text-white text-sm hover:bg-white/20 transition-colors border border-white/20">Software Architecture</a>
        <a href="#analytics" class="px-4 py-2 rounded-full bg-white/10 text-white text-sm hover:bg-white/20 transition-colors border border-white/20">Data Analytics</a>
        <a href="#integrations" class="px-4 py-2 rounded-full bg-white/10 text-white text-sm hover:bg-white/20 transition-colors border border-white/20">Integrations</a>
      </div>
    </Fragment>
  </Hero>

  <!-- SERVICE 1: Institutional -->
  <Content
    id="institutional"
    isReversed
    tagline="Service 01"
    title="Institutional and Government Web Portals"
    items={[
      {
        title: "Compliance and accessibility built-in",
        description: "We design every institutional portal to meet WCAG 2.1 AA accessibility standards and relevant government regulatory requirements from the ground up.",
        icon: "tabler:shield-check",
      },
      {
        title: "Secure by design",
        description: "Government-grade security practices including penetration testing, secure authentication, data encryption, and audit logging.",
        icon: "tabler:lock",
      },
      {
        title: "Scalable CMS architecture",
        description: "Headless CMS implementations that empower your content teams without requiring developer intervention for daily operations.",
        icon: "tabler:database",
      },
      {
        title: "Multilingual and multi-tenant ready",
        description: "Built for organizations that serve diverse populations with complex content hierarchies and multi-language requirements.",
        icon: "tabler:world",
      },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80",
      alt: "Government and institutional web portals",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Portals that governments and institutions trust</h3>
      <p class="text-muted">We have delivered secure, accessible, and highly available web portals for public sector agencies, universities, and healthcare institutions. Our specialists understand the unique compliance, procurement, and operational requirements of institutional clients.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- SERVICE 2: Mobile -->
  <Content
    id="mobile"
    isAfterContent
    tagline="Service 02"
    title="Mobile Application Development"
    items={[
      {
        title: "Cross-platform excellence",
        description: "React Native and Flutter applications that deliver native-quality experiences on both iOS and Android from a single codebase.",
        icon: "tabler:device-mobile",
      },
      {
        title: "Full product lifecycle",
        description: "From UX/UI design through development, QA, App Store submission, and post-launch monitoring and iteration.",
        icon: "tabler:refresh",
      },
      {
        title: "Performance-first engineering",
        description: "Optimized render cycles, offline-first architectures, and lean bundle sizes that deliver fast, smooth experiences.",
        icon: "tabler:rocket",
      },
      {
        title: "Backend integration",
        description: "Seamless integration with REST and GraphQL APIs, push notification systems, analytics, and third-party SDKs.",
        icon: "tabler:plug-connected",
      },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80",
      alt: "Mobile application development",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Apps that users actually love using</h3>
      <p class="text-muted">Our mobile team brings together design sensibility, engineering rigor, and deep platform knowledge to deliver applications that perform beautifully and keep users coming back. We handle every stage from concept to store.</p>
    </Fragment>
  </Content>

  <!-- SERVICE 3: Architecture -->
  <Content
    id="architecture"
    isReversed
    isAfterContent
    tagline="Service 03"
    title="Software Architecture and Engineering"
    items={[
      {
        title: "Microservices and distributed systems",
        description: "Domain-driven microservice architectures designed for independent deployment, team autonomy, and horizontal scale.",
        icon: "tabler:sitemap",
      },
      {
        title: "Cloud-native infrastructure",
        description: "AWS, GCP, and Azure deployments using infrastructure-as-code, managed Kubernetes, and serverless where appropriate.",
        icon: "tabler:cloud",
      },
      {
        title: "API-first design",
        description: "RESTful and GraphQL APIs designed for developer experience, versioning, documentation, and long-term maintainability.",
        icon: "tabler:api",
      },
      {
        title: "Architecture reviews",
        description: "Independent review of your existing architecture with concrete, prioritized recommendations for improvement.",
        icon: "tabler:clipboard-check",
      },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80",
      alt: "Software architecture",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Systems built to grow with your business</h3>
      <p class="text-muted">Good architecture is invisible when it works, and catastrophic when it fails. Our architects design systems that are reliable, observable, and maintainable, with the right balance of simplicity and sophistication for your scale.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- SERVICE 4: Data -->
  <Content
    id="analytics"
    isAfterContent
    tagline="Service 04"
    title="Data Analytics and Intelligence"
    items={[
      {
        title: "Data pipeline engineering",
        description: "End-to-end ETL/ELT pipelines that ingest, transform, and deliver clean, reliable data at the cadence your business requires.",
        icon: "tabler:arrows-transfer-down",
      },
      {
        title: "Business intelligence dashboards",
        description: "Power BI, Tableau, and Metabase implementations giving leadership real-time visibility into the metrics that matter.",
        icon: "tabler:chart-bar",
      },
      {
        title: "Predictive analytics and ML",
        description: "Applied machine learning models for forecasting, anomaly detection, customer segmentation, and process optimization.",
        icon: "tabler:brain",
      },
      {
        title: "Data warehouse design",
        description: "Modern data warehouse architecture on Snowflake, BigQuery, or Redshift, designed for analytical workloads and BI tooling.",
        icon: "tabler:building-warehouse",
      },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80",
      alt: "Data analytics",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">From raw data to real decisions</h3>
      <p class="text-muted">Most organizations are sitting on data goldmines they cannot access. Our data team transforms siloed, messy data into clean, reliable intelligence that gives your leaders the clarity to act with confidence.</p>
    </Fragment>
  </Content>

  <!-- SERVICE 5: Integrations -->
  <Content
    id="integrations"
    isReversed
    isAfterContent
    tagline="Service 05"
    title="Seamless System Integration"
    items={[
      {
        title: "ERP and CRM integration",
        description: "Connect Salesforce, HubSpot, SAP, Oracle, and other enterprise platforms into a unified, real-time data ecosystem.",
        icon: "tabler:refresh",
      },
      {
        title: "Payment and fintech APIs",
        description: "Secure integration of payment gateways, banking APIs, and financial data providers with full PCI compliance considerations.",
        icon: "tabler:credit-card",
      },
      {
        title: "Event-driven architecture",
        description: "Kafka and RabbitMQ-based messaging systems for real-time, reliable event propagation across complex system landscapes.",
        icon: "tabler:activity",
      },
      {
        title: "Legacy system modernization",
        description: "Strangler fig patterns and API wrapping strategies that let you modernize incrementally without big-bang rewrites.",
        icon: "tabler:transform",
      },
    ]}
    image={{
      src: "https://images.unsplash.com/photo-1544197150-b99a580bb7a8?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80",
      alt: "System integration",
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">One unified ecosystem, zero silos</h3>
      <p class="text-muted">Fragmented systems create fragmented businesses. We design and implement integration layers that connect your tools, eliminate manual data transfer, and give your entire organization a single source of truth.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- ENGAGEMENT OPTIONS -->
  <Features2
    tagline="Engagement Models"
    title="How we work with clients"
    subtitle="We adapt our engagement model to suit your organization, budget, and timeline."
    columns={3}
    items={[
      {
        title: "Project-based",
        description: "Fixed scope, defined deliverables, clear timeline. Ideal for organizations with a well-defined challenge and a clear outcome in mind.",
        icon: "tabler:clipboard-list",
      },
      {
        title: "Embedded specialist",
        description: "A Codemyc professional joins your team for a defined period, providing senior expertise on-demand while transferring knowledge to your staff.",
        icon: "tabler:user-check",
      },
      {
        title: "Architecture advisory",
        description: "Strategic technical guidance for CTO, VP Engineering, and product leadership, without full-time engagement. Reviews, roadmaps, and decision support.",
        icon: "tabler:telescope",
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </Features2>

  <CallToAction
    actions={[
      { variant: "primary", text: "Discuss Your Project", href: "/contact", icon: "tabler:send" },
      { text: "Meet Our Team", href: "/team" },
    ]}
  >
    <Fragment slot="title">
      Not sure which service fits?<br /><span class="text-cyan-500">Let us figure it out together.</span>
    </Fragment>
    <Fragment slot="subtitle">
      Tell us about your challenge and we will recommend the right approach, the right team, and a realistic plan.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 codemyc-hero-bg"></div>
    </Fragment>
  </CallToAction>
</Layout>
