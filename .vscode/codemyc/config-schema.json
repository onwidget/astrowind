{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "trailingSlash": {
          "type": "boolean"
        },
        "googleSiteVerificationId": {
          "type": "string"
        }
      },
      "required": ["name", "site", "base", "trailingSlash"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            },
            "template": {
              "type": "string"
            }
          },
          "required": ["default", "template"],
          "additionalProperties": false
        },
        "description": {
          "type": "string"
        },
        "robots": {
          "type": "object",
          "properties": {
            "index": {
              "type": "boolean"
            },
            "follow": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "openGraph": {
          "type": "object",
          "properties": {
            "site_name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "images": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  },
                  "alt": {
                    "type": "string"
                  }
                },
                "required": ["url"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "twitter": {
          "type": "object",
          "properties": {
            "handle": {
              "type": "string"
            },
            "site": {
              "type": "string"
            },
            "cardType": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "i18n": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "textDirection": {
          "type": "string",
          "enum": ["ltr", "rtl"]
        }
      },
      "required": ["language", "textDirection"],
      "additionalProperties": false
    }
  },
  "required": ["site", "metadata", "i18n"],
  "additionalProperties": false
}
